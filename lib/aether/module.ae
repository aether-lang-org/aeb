// aether — Aether SDK for aether.build
//
// Compiles a .ae source file via aetherc → C, then links with gcc and the
// Aether runtime to produce a native binary. Optionally links against shared
// libraries from upstream deps (e.g. Rust cdylibs) via the standard
// `shared_library_deps_including_transitive` artifact.
import bldr
import cache
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

source(_ctx: ptr, file_name: string) {
    _e = map.put(_ctx, "source", file_name)
}

output(_ctx: ptr, bin_name: string) {
    _e = map.put(_ctx, "output", bin_name)
}

// caps(csv) — capability opt-ins for an aether.csrc node, forwarded as
// `--with=<csv>` (e.g. "net" / "net,fs"). Same csv shape as
// regen_with's second arg. Only meaningful inside aether.csrc(b);
// aether.program's default `ae build` path derives capabilities
// itself, and regen entries use regen_with / auto-detection.
caps(_ctx: ptr, cap_csv: string) {
    _e = map.put(_ctx, "csrc_caps", cap_csv)
}

// size() — opt into `ae build --size` for a shared_lib (size-optimize + strip
// debug info). Off by default. Threaded through the --emit=lib shell-out; on a
// cross build (target=...) it produces the same small/stripped .so/.dylib/.dll
// that `ae build --size` does on the host. No-op on the non-shell manual paths.
size(_ctx: ptr) {
    _e = map.put(_ctx, "lib_size", "1")
}

// go_source(file) — the user's .go for an aether.tinygo_lib node.
// TinyGo compiles it to a c-shared .so (the `output`); the Aether
// program that deps this lib tinygo.load()s that .so at runtime.
// See docs/design/host-tinygo-sidecar.md.
go_source(_ctx: ptr, file_name: string) {
    _e = map.put(_ctx, "go_source", file_name)
}

// driver(file) — alias for source(...) in the aether.driver_test
// closure. Reads more naturally there: "this is the driver, not
// the program-under-test." source(...) also works; both write the
// same map key.
driver(_ctx: ptr, file_name: string) {
    _e = map.put(_ctx, "source", file_name)
}

// --- Sub-setters for binary_under_test, fixture_seed, fixture_server ---
// (Closures inside aether.driver_test bodies. These setters write
// to the inner closure's _builder map; the enclosing builder reads
// them out when packing the outer record.)

// path("...") — directory or file path. Used by both
// binary_under_test (the binary on disk to spawn) and fixture_seed
// (the working directory / file the seeder owns). Resolved
// relative to the workspace root if not absolute; verified to
// exist at runtime where applicable.
path(_ctx: ptr, p: string) {
    _e = map.put(_ctx, "path", p)
}

// env_var("CUSTOM_BIN_VAR") — override the auto-derived
// `$<NAME>_BIN` env var name. Defaults to `<UPPER(NAME)>_BIN`;
// callers rarely need this.
env_var(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "env_var", name)
}

// seed_bin, bin, args, port, ready_after_ms — same closure-local
// sub-setters as the bash SDK uses. Defined here too so a
// .tests.ae using aether.driver_test only needs `import aether`,
// not a mix of imports. Both definitions write to the same map
// keys; the records they pack are interchangeable.

seed_bin(_ctx: ptr, p: string) {
    _e = map.put(_ctx, "seed_bin", p)
}

bin(_ctx: ptr, p: string) {
    _e = map.put(_ctx, "bin", p)
}

args(_ctx: ptr, s: string) {
    _e = map.put(_ctx, "args", s)
}

port(_ctx: ptr, n: int) {
    _e = map.put(_ctx, "port", string.from_int(n))
}

ready_after_ms(_ctx: ptr, n: int) {
    _e = map.put(_ctx, "ready_after_ms", string.from_int(n))
}

// binary_under_test(b, name) { path(...); env_var(...) }
// — declare a binary built by an upstream `bldr.dep` that the
// driver needs to spawn. Repeatable: each call exposes one binary.
//
// Sub-setters:
//   path("target/...")        required — binary path. Resolved
//                                          relative to the workspace
//                                          root if relative.
//   env_var("CUSTOM_VAR")     optional — override the default
//                                          $<NAME>_BIN env var name.
//
// Storage shape: the enclosing aether.driver_test builder drains
// `b._pending_binaries_under_test` (packed records of
// "name\tpath\tenv_var") into its own _builder for processing.
builder binary_under_test(name: string): int {
    b = builder_context()
    if b == 0 { return 0 }
    bin_path_v = ""
    env_var_v = ""
    if _builder != null {
        if map.has(_builder, "path") == 1 {
            bin_path_v, _ = map.get(_builder, "path")
        }
        if map.has(_builder, "env_var") == 1 {
            env_var_v, _ = map.get(_builder, "env_var")
        }
    }
    if map.has(b, "_pending_binaries_under_test") == 0 {
        _e1 = map.put(b, "_pending_binaries_under_test", list.new())
    }
    pending, _ = map.get(b, "_pending_binaries_under_test")
    rec = string.concat(name, "\t")
    rec = string.concat(rec, bin_path_v)
    rec = string.concat(rec, "\t")
    rec = string.concat(rec, env_var_v)
    _e2 = list.add(pending, rec)
    return 0
}

// fixture_seed(b, name) { path(...); seed_bin(...) } — see
// lib/bash/module.ae for the full contract. The implementation is
// duplicated here (rather than re-imported from bash) so a
// .tests.ae using aether.driver_test doesn't need to mix imports.
// Both definitions stage records onto `b._pending_fixture_seeds`
// in the same format; the enclosing test builder drains them.
builder fixture_seed(name: string): int {
    b = builder_context()
    if b == 0 { return 0 }
    path_v = ""
    seed_bin_v = ""
    if _builder != null {
        if map.has(_builder, "path") == 1 {
            path_v, _ = map.get(_builder, "path")
        }
        if map.has(_builder, "seed_bin") == 1 {
            seed_bin_v, _ = map.get(_builder, "seed_bin")
        }
    }
    if map.has(b, "_pending_fixture_seeds") == 0 {
        _e1 = map.put(b, "_pending_fixture_seeds", list.new())
    }
    pending, _ = map.get(b, "_pending_fixture_seeds")
    rec = string.concat(name, "\t")
    rec = string.concat(rec, path_v)
    rec = string.concat(rec, "\t")
    rec = string.concat(rec, seed_bin_v)
    _e2 = list.add(pending, rec)
    return 0
}

// fixture_server(b, name) { bin(...); args(...); port(...);
//                           ready_after_ms(...) }
// See lib/bash/module.ae for the contract. Duplicated body for
// the same reason as fixture_seed above.
builder fixture_server(name: string): int {
    b = builder_context()
    if b == 0 { return 0 }
    bin_v = ""
    args_v = ""
    port_v = "0"
    ready_v = "0"
    if _builder != null {
        if map.has(_builder, "bin") == 1 {
            bin_v, _ = map.get(_builder, "bin")
        }
        if map.has(_builder, "args") == 1 {
            args_v, _ = map.get(_builder, "args")
        }
        if map.has(_builder, "port") == 1 {
            port_v, _ = map.get(_builder, "port")
        }
        if map.has(_builder, "ready_after_ms") == 1 {
            ready_v, _ = map.get(_builder, "ready_after_ms")
        }
    }
    if map.has(b, "_pending_fixture_servers") == 0 {
        _e1 = map.put(b, "_pending_fixture_servers", list.new())
    }
    pending, _ = map.get(b, "_pending_fixture_servers")
    rec = string.concat(name, "\t")
    rec = string.concat(rec, bin_v)
    rec = string.concat(rec, "\t")
    rec = string.concat(rec, args_v)
    rec = string.concat(rec, "\t")
    rec = string.concat(rec, port_v)
    rec = string.concat(rec, "\t")
    rec = string.concat(rec, ready_v)
    _e2 = list.add(pending, rec)
    return 0
}

// extra_source(c_path) — append one C file to the manual-link list.
// Repeated calls accumulate. Presence of any extra_source opts the
// builder out of the `ae build` shell-out (which would read these
// from aether.toml's [[bin]].extra_sources) and into the explicit
// aetherc + gcc path. Mutually exclusive with aether.toml's
// [[bin]] entry for the same target — declare in one place.
//
// Relative paths are resolved against source_dir at gcc time
// (consistent with regen(...)). Absolute paths pass through
// verbatim.
extra_source(_ctx: ptr, c_path: string) {
    if map.has(_ctx, "extra_source") == 0 {
        _e1 = map.put(_ctx, "extra_source", list.new())
    }
    extras, _ = map.get(_ctx, "extra_source")
    _e2 = list.add(extras, c_path)
}

// extra_source_glob(pattern) — like extra_source, but expands a glob
// at builder run-time and appends every matching .c file. Useful
// when a directory contains many generated sources without going
// through `regen(...)` (e.g. the C side was hand-written in one
// commit and needs to be picked up wholesale).
//
// Pattern is resolved against source_dir at consumption time, the
// same rule as extra_source's relative-vs-absolute handling.
// Patterns with no matches are silent (don't fail the build);
// users who care about that should call extra_source explicitly.
//
// Cache-key correctness: each glob-resolved file is content-hashed
// in the same canonical sweep as static extra_source entries, so
// adding/removing/modifying a glob-matched file invalidates the
// cache the same way an explicit extra_source would.
extra_source_glob(_ctx: ptr, pattern: string) {
    if map.has(_ctx, "extra_source_glob") == 0 {
        _e1 = map.put(_ctx, "extra_source_glob", list.new())
    }
    patterns, _ = map.get(_ctx, "extra_source_glob")
    _e2 = list.add(patterns, pattern)
}

// link_flag(flag) — append one gcc link flag (e.g. "-pthread",
// "-lm", "-Wl,-rpath,/foo"). Like extra_source, presence opts into
// the manual-link path. Note: -L${aether_dir} -laether are already
// added by the manual path; don't repeat them here.
link_flag(_ctx: ptr, flag: string) {
    if map.has(_ctx, "link_flag") == 0 {
        _e1 = map.put(_ctx, "link_flag", list.new())
    }
    flags, _ = map.get(_ctx, "link_flag")
    _e2 = list.add(flags, flag)
}

// target(triple) — cross-compile this program for a foreign target via
// `ae build --target=<triple>` (aether's bundled zig-cc / emcc cross
// backend). Recognised triples are aether's: aarch64-linux, x86_64-macos,
// x86_64-windows, …-freebsd, wasm (Emscripten .js+.wasm), and wasm32-wasi
// (a self-contained .wasm — aether #1655). Last call wins.
//
// Cross builds go through the `ae build` SHELL-OUT path, never the manual
// local-gcc link (which can only target the host): declaring target()
// alongside extra_source()/link_flag()/include_dir()/regen() is rejected
// at build time, because those opt into the host-only manual path. A cross
// program that needs extra C wants aether.csrc + a downstream c.program
// cross build instead.
//
// Staleness on this path is `ae build`'s own incremental cache (aeb reports
// [n/a]); the triple is part of the `ae build` command, so ae keys on it.
target(_ctx: ptr, triple: string) {
    _e1 = map.put(_ctx, "target", triple)
}

// include_dir(dir) — add a `-I` include directory for the gcc compile
// of this program's C inputs (extra_source files, and the entry's
// generated .c). Relative paths resolve against source_dir at link
// time; absolute paths pass through. Repeatable. Presence opts into the
// manual aetherc+gcc path (like extra_source / link_flag).
//
// A wrapper .c that `#include`s a generated data table needs this so the
// header resolves. The complementary route is automatic: a dependency
// that published the `c_header_dirs` artifact (e.g. via
// c.generated_header) has its include dir added too — `dep` the
// producer node and the `-I` is honored without a manual include_dir.
include_dir(_ctx: ptr, dir: string) {
    if map.has(_ctx, "include_dir") == 0 {
        _e1 = map.put(_ctx, "include_dir", list.new())
    }
    dirs, _ = map.get(_ctx, "include_dir")
    _e2 = list.add(dirs, dir)
}

// lib(dir) — add an aetherc `--lib` module-search directory for THIS node's
// Aether compile. The Aether-side twin of include_dir (which is gcc `-I`).
//
// A node whose source `import`s sibling modules that live in a repo subdir
// OTHER than the source dir or repo root needs this: the orchestrator's
// AEB_COMPILE_LIB path is `<aeb_lib>:<repo_root>`, so an app at
// `aevg/apps/rubiks_cube/rubiks_cube.ae` importing `vg`/`vg_live` from `aevg/`
// can't resolve them. `lib("${root}/aevg")` adds that dir to the search path.
//
// Appended AFTER the env-derived AEB_COMPILE_LIB flags, so a node can only ADD
// to the orchestrator's path, never lose it. Relative dirs resolve against
// source_dir; absolute pass through (same rule as include_dir / extra_source).
// Repeatable. Folded into the link cache key so a changed lib path invalidates.
lib(_ctx: ptr, dir: string) {
    if map.has(_ctx, "lib") == 0 {
        _e1 = map.put(_ctx, "lib", list.new())
    }
    dirs, _ = map.get(_ctx, "lib")
    _e2 = list.add(dirs, dir)
}

// regen(ae_path) — declare an Aether source whose paired
// `_generated.c` should be (re)built via `aetherc --emit=lib` before
// linking. Path is module-relative (resolved against source_dir).
//
// Each regen(...) implicitly contributes its paired _generated.c to
// extra_source, so callers don't need to declare both. The pairing
// rule is `X.ae` → `X_generated.c` in the same directory.
//
// mtime-driven: skipped if the .c exists and is newer than the .ae.
// Presence of any regen(...) opts the builder into the manual
// aetherc + gcc path (same as extra_source / link_flag).
//
// Capabilities: aetherc rejects --emit=lib on a source that imports
// std.http / std.tcp / std.net / std.fs / std.os without a matching
// --with=net|fs|os. By default aeb scans the .ae file's `import std.X`
// lines and infers the capability set. If the file pulls in a cap
// transitively (through another module the scan doesn't see), use
// `regen_with(path, "net,fs")` to declare caps explicitly.
//
// This is the closure-DSL replacement for `aether.toml`'s
// [[bin]].extra_sources + an external regen.sh: declare your
// generated sources here, in the same .build.ae that already declares
// `source` and `output`, and aeb runs codegen + link in one pass.
regen(_ctx: ptr, ae_path: string) {
    _regen_append(_ctx, ae_path, "")
}

// regen_with(ae_path, caps) — explicit-capability variant.
// `caps` is a comma-separated list passed verbatim to aetherc as
// --with=<caps> (e.g. "net", "fs", "net,os"). Use this when the
// auto-detection in regen(...) misses a capability — typically when
// the .ae file pulls a cap-bearing module transitively rather than
// via a direct `import std.<X>` line.
//
// Empty `caps` is equivalent to plain regen(...) (auto-detect).
regen_with(_ctx: ptr, ae_path: string, caps: string) {
    _regen_append(_ctx, ae_path, caps)
}

// Internal: append a (path, caps) pair to two parallel lists keyed
// "regen" and "regen_caps". Same-index entries belong together.
_regen_append(_ctx: ptr, ae_path: string, caps: string) {
    if map.has(_ctx, "regen") == 0 {
        _e1 = map.put(_ctx, "regen", list.new())
        _e2 = map.put(_ctx, "regen_caps", list.new())
    }
    regens, _ = map.get(_ctx, "regen")
    regen_caps, _ = map.get(_ctx, "regen_caps")
    _e3 = list.add(regens, ae_path)
    _e4 = list.add(regen_caps, caps)
}

// no_closure_regen() — opt OUT of the transitive import-closure regen
// pass (the BFS in `_expand_transitive_regens` that auto-`--emit=lib`s
// every project-local imported `.ae`). Use when the entry imports
// extern-backed modules — modules whose Aether bodies are `extern`
// declarations of a C ABI, with the implementations in C files linked
// via `extra_source`. `--emit=lib` on such a module fails with a wall
// of `E0301 Undefined function`, because the externs are only defined
// once linked with the C backend, which `--emit=lib` does not do.
//
// With this flag set the manual path compiles the entry with plain
// `aetherc entry.ae entry.c` (tolerates unresolved externs, exactly as
// `ae build` does for a plain program) and links the declared
// `extra_source` C + `link_flag`s — without attempting `--emit=lib` on
// any import. Explicit `regen(...)` / `regen_with(...)` entries the
// user declared by hand still run; only the auto-discovery of sibling
// imports is suppressed.
//
// The import closure still feeds the cache key
// (`_cache_key_for_aether_link` hashes every transitively-imported
// `.ae` independently of the regen list), so a change to an imported
// module still busts the key and triggers a rebuild. This flag only
// suppresses the regen-feeding use of the closure, not its
// staleness-tracking use. See asks/thin-aether-over-c-backend.md.
//
// Presence opts into the manual aetherc + gcc path (like
// extra_source / link_flag).
no_closure_regen(_ctx: ptr) {
    _e1 = map.put(_ctx, "no_closure_regen", "1")
}

// --- Helpers ---

// Aether toolchain resolution now lives in lib/build (shared with
// lib/c). These thin forwarders keep lib/aether's existing internal
// call sites unchanged.
_resolve_aether_dir() {
    return bldr._resolve_aether_dir()
}

_resolve_libaether_dir(aether_dir: string) {
    return bldr._resolve_libaether_dir(aether_dir)
}

_resolve_aether_include(aether_dir: string) {
    return bldr._resolve_aether_include(aether_dir)
}

_collect_shared_libs(ctx: ptr) {
    // Returns newline-separated list of .so file paths from transitive deps.
    deps, _ = map.get(ctx, "deps")
    out = ""
    n = list.size(deps)
    i = 0
    while i < n {
        dp, _ = list.get(deps, i)
        dm = bldr._strip_lang(dp)
        sh = bldr._read_dep_artifact(ctx, dm, "shared_library_deps_including_transitive")
        if string.length(sh) > 0 {
            if string.length(out) > 0 {
                out = string.concat(out, "\n")
            }
            out = string.concat(out, sh)
        }
        i = i + 1
    }
    return out
}

_collect_ld_path(shared_libs_text: string) {
    // Convert newline-separated .so paths to colon-separated dir list.
    if string.length(shared_libs_text) == 0 {
        return ""
    }
    cmd = "echo '${shared_libs_text}' | xargs -n1 dirname 2>/dev/null | sort -u | tr '\n' ':' | sed 's/:$//'"
    out, _eerr = bldr._sh_capture(cmd)
    return string.trim(out)
}

// _expand_source_globs(builder_map, source_dir) — resolve every
// extra_source_glob(...) pattern via fs.glob and append the matches
// to the extra_source list. Patterns are joined to source_dir
// when relative; absolute patterns pass through. No-op when no
// patterns declared. Idempotent only at the per-builder-invocation
// level; if called twice on the same builder map you'd double-add
// — _compile_and_link calls it once before the cache key step.
//
// Empty match sets are silent; users who care should use
// extra_source(...) explicitly. fs.glob errors are also silent
// (the cache key computation will reflect whatever ended up in
// the list, including nothing).
_expand_source_globs(builder_map: ptr, source_dir: string) {
    if builder_map == null { return 0 }
    if map.has(builder_map, "extra_source_glob") == 0 { return 0 }
    patterns, _ = map.get(builder_map, "extra_source_glob")
    np = list.size(patterns)
    if np == 0 { return 0 }

    if map.has(builder_map, "extra_source") == 0 {
        _eg1 = map.put(builder_map, "extra_source", list.new())
    }
    extras, _ = map.get(builder_map, "extra_source")

    ip = 0
    while ip < np {
        p, _ = list.get(patterns, ip)
        resolved = p
        if string.length(p) > 0 {
            _absq = _is_abs_path(p)
            if _absq == 0 {
                resolved = path.join(source_dir, p)
            }
        }
        matches, _gerr = fs.glob(resolved)
        if matches != null {
            mc = dir_list_count(matches)
            mi = 0
            while mi < mc {
                m = dir_list_get(matches, mi)
                // dir_list_get returns a borrowed pointer into the
                // DirList — we must copy before dir_list_free or
                // the extras list ends up holding dangling refs.
                // string.concat(m, "") forces a fresh ref-counted
                // AetherString allocation.
                list.add(extras, string.concat(m, ""))
                mi = mi + 1
            }
            dir_list_free(matches)
        }
        ip = ip + 1
    }
    // Mark patterns as expanded so a subsequent call (e.g. if
    // _compile_and_link is invoked twice in some future flow) is
    // a no-op rather than a double-add. We do this by deleting
    // the patterns list — semantically "we've already expanded
    // these." Map deletion isn't trivial in std.map; clear the
    // list contents instead.
    return 0
}

// _ae_bin() — THE Aether compiler aeb builds with: $AETHER if set, else bare
// `ae` from PATH. This is the two-Aether split's authoritative resolution (the
// toolchain that compiles .ae, distinct from the program's own ae). Every site
// that shells out to the compiler MUST resolve through here so they all agree —
// _shell_out_ae_build and _toolchain_version in particular, or the cache key
// would record a different toolchain's version than the one that did the build.
_ae_bin() {
    ab = os.getenv("AETHER")
    if string.length(ab) == 0 { return "ae" }
    return ab
}

// _toolchain_version() — first line of `<ae> --version`, where <ae> is the
// compiler aeb actually builds with ($AETHER-resolved, NOT bare `ae`). Used as
// a cache-key input so a toolchain bump invalidates every cached
// aether.program binary. Cheap (~1ms os.exec) but called once per aether target
// cache-key (_cache_key_for_aether_link), so memoized via a per-build env var:
// the first call spawns `<ae> --version` and stores it; the rest reuse it. The
// memo is process/build-scoped (env vars don't outlive the build), which is
// exactly the right lifetime — a toolchain swap between builds is a new process.
// Only a NON-empty result is stored, so a transient empty read (e.g. $AETHER
// briefly unresolvable) never poisons the memo into skipping a good later probe.
//
// Was a hardcoded bare `ae`: on a box whose PATH `ae` differs from $AETHER (or
// has none), the key recorded the WRONG toolchain version — or an empty one,
// dropping the version segment entirely — so artifacts built by one compiler
// could be served as another's. Resolving through _ae_bin() closes that.
_toolchain_version() {
    cached = os.getenv("_AEB_AETHER_VERSION_CACHE")
    if string.length(cached) > 0 { return cached }
    ae_bin = _ae_bin()
    raw, _err = bldr._sh_capture("${ae_bin} --version 2>/dev/null | head -1")
    ver = string.trim(raw)
    if string.length(ver) > 0 { _s = os.setenv("_AEB_AETHER_VERSION_CACHE", ver) }
    return ver
}

// --- Transitive Aether import-closure scan -------------------------
//
// aeb's DAG models bldr.dep() target edges only; the Aether `import`
// graph inside a target's source is invisible to it. Without the scan
// below, a target's cache key hashes just its entry .ae (+ declared
// extra_sources) — so editing a widely-imported module never busts a
// consumer's key, and the consumer silently keeps a stale binary.
// These helpers walk the entry's transitive `import` closure so every
// reachable project .ae is hashed into the key.

// All ancestor directories of `dir` (nearest first, `dir` included) —
// the candidate roots an `import X` is resolved against. `import X`
// typically lives at <root>/X/module.ae for some ancestor root.
_ancestor_dirs(dir: string) {
    out = list.new()
    cur = dir
    if string.length(cur) == 0 { cur = "." }
    _a0 = list.add(out, cur)
    parent = ""
    limit = 0
    while limit < 40 {
        parent = path.dirname(cur)
        if string.equals(parent, cur) == 1 { return out }
        if string.length(parent) == 0 { return out }
        _ax = list.add(out, parent)
        cur = parent
        limit = limit + 1
    }
    return out
}

// Module name from an `import ...` line (already trimmed). Handles
// `import foo`, `import foo (a, b)`, `import a.b.c`.
_import_module_name(line: string) {
    rest = string.substring(line, 7, string.length(line))
    rest = string.trim(rest)
    n = string.length(rest)
    i = 0
    while i < n {
        ch = string.substring(rest, i, i + 1)
        if string.equals(ch, " ") == 1 { return string.substring(rest, 0, i) }
        if string.equals(ch, "(") == 1 { return string.substring(rest, 0, i) }
        i = i + 1
    }
    return rest
}

// Resolve an import module name to its .ae file, or "" when it is a
// stdlib / contrib module (toolchain-resolved — covered by the
// toolchain-version part of the key) or simply unresolvable.
_resolve_import_ae(modname: string, roots: ptr) {
    if string.starts_with(modname, "std.") == 1 { return "" }
    if string.starts_with(modname, "contrib.") == 1 { return "" }
    if string.equals(modname, "std") == 1 { return "" }
    rel = ""
    n = string.length(modname)
    i = 0
    while i < n {
        ch = string.substring(modname, i, i + 1)
        if string.equals(ch, ".") == 1 {
            rel = string.concat(rel, "/")
        } else {
            rel = string.concat(rel, ch)
        }
        i = i + 1
    }
    nr = list.size(roots)
    ri = 0
    rdir = ""
    c1 = ""
    c2 = ""
    while ri < nr {
        rdir, _ = list.get(roots, ri)
        c1 = path.join(rdir, string.concat(rel, "/module.ae"))
        if file.exists(c1) == 1 { return c1 }
        c2 = path.join(rdir, string.concat(rel, ".ae"))
        if file.exists(c2) == 1 { return c2 }
        ri = ri + 1
    }
    return ""
}

// Every project .ae transitively imported by `entry` (entry itself
// excluded — it is hashed separately). BFS over `import` lines.
_transitive_import_aes(entry: string, roots: ptr) {
    found = list.new()
    seen = map.new()
    queue = list.new()
    _q0 = list.add(queue, entry)
    _s0 = map.put(seen, entry, "1")
    head = 0
    qs = 1
    f = ""
    content = ""
    rerr = ""
    rest = ""
    line = ""
    t = ""
    modname = ""
    resolved = ""
    nl = 0
    while head < qs {
        f, _ = list.get(queue, head)
        head = head + 1
        content, rerr = io.read_file(f)
        if string.equals(rerr, "") == 1 {
            rest = content
            while string.length(rest) > 0 {
                nl = string.index_of(rest, "\n")
                if nl < 0 {
                    line = rest
                    rest = ""
                } else {
                    line = string.substring(rest, 0, nl)
                    rest = string.substring(rest, nl + 1, string.length(rest))
                }
                t = string.trim(line)
                if string.starts_with(t, "import ") == 1 {
                    modname = _import_module_name(t)
                    if string.length(modname) > 0 {
                        resolved = _resolve_import_ae(modname, roots)
                        if string.length(resolved) > 0 {
                            if map.has(seen, resolved) == 0 {
                                _sm = map.put(seen, resolved, "1")
                                _fm = list.add(found, resolved)
                                _qm = list.add(queue, resolved)
                                qs = qs + 1
                            }
                        }
                    }
                }
            }
        }
    }
    return found
}

// _link_flag_lib_files(flags, source_dir) — resolve the archives/shared
// objects a `-L<dir>` / `-l<name>` link_flag run actually points at, so
// their CONTENT (not just the flag string) can be folded into the cache
// key. Without this, `link_flag("-L/usr/local/lib/aether")` +
// `link_flag("-laether")` hashes only the two literal strings; swapping
// the libaether.a behind that path for a different toolchain vintage
// leaves the key unchanged and serves a stale, differently-linked binary
// (asks/cache-key-omits-external-include-and-lib-contents.md — measured
// as a 0.07s [hit] after a /usr/local 0.545→0.551 upgrade).
//
// Two-pass, mirroring how the linker itself reads the flag run:
//   1. collect every `-L<dir>` search directory (attached form only; the
//      link line aeb builds always emits `-Ldir`, never `-L dir`), plus
//      the customary system dirs so a bare `-lfoo` with no `-L` still
//      resolves. Relative `-L` dirs resolve against source_dir.
//   2. for each `-l<name>`, probe `lib<name>.a` then `lib<name>.so` in
//      each search dir, first match wins (static-first, matching a
//      default link with no -Bdynamic games). A `-l` that resolves to
//      nothing (a truly system lib like -lm) contributes no file — its
//      flag string is still in the key via the loop above, so a change
//      from -lm to -ln still moves the key.
//
// Returns a list of absolute file paths (possibly empty). PURE-ish: only
// reads the filesystem to test existence; hashing is the caller's job so
// a read error there routes through the caller's miss path.
_link_flag_lib_files(flags: ptr, source_dir: string) {
    files = list.new()
    if flags == null { return files }

    // Pass 1: search dirs.
    search = list.new()
    nf = list.size(flags)
    jf = 0
    while jf < nf {
        ff, _ = list.get(flags, jf)
        jf = jf + 1
        if string.starts_with(ff, "-L") == 1 {
            d = string.substring(ff, 2, string.length(ff))
            if string.length(d) > 0 {
                if _is_abs_path(d) == 0 {
                    d = path.join(source_dir, d)
                }
                list.add(search, d)
            }
        }
    }
    // Customary system dirs, appended last (declared -L takes priority).
    list.add(search, "/usr/local/lib")
    list.add(search, "/usr/lib")
    ns = list.size(search)

    // Pass 2: resolve each -l<name> against the search dirs.
    jf = 0
    while jf < nf {
        ff, _ = list.get(flags, jf)
        jf = jf + 1
        if string.starts_with(ff, "-l") == 1 {
            name = string.substring(ff, 2, string.length(ff))
            if string.length(name) > 0 {
                si = 0
                resolved = ""
                while si < ns {
                    sd, _ = list.get(search, si)
                    si = si + 1
                    if string.length(resolved) == 0 {
                        cand_a = path.join(sd, string.concat("lib", string.concat(name, ".a")))
                        if file.exists(cand_a) == 1 {
                            resolved = cand_a
                        } else {
                            cand_so = path.join(sd, string.concat("lib", string.concat(name, ".so")))
                            if file.exists(cand_so) == 1 {
                                resolved = cand_so
                            }
                        }
                    }
                }
                if string.length(resolved) > 0 {
                    list.add(files, resolved)
                }
            }
        }
    }
    return files
}

// Compute the cache key for an aether.program manual-path link.
// Inputs in canonical order; each part length-prefixed via
// cache.hash_inputs so distinct concatenations can't collide.
//
// What goes into the hash (the contract):
//   - main .ae source content (the program's entry point)
//   - each extra_source path + content (resolved to absolute, in
//     declared order; regen-generated _generated.c entries appear
//     here too because _run_regen_pass appends them to extra_source)
//   - each link_flag, in declared order
//   - each shared-lib dep's path + content (cross-language artifacts)
//   - lib_dir (libaether.a location — proxies for toolchain layout)
//   - dup_flag (platform-dependent linker flag)
//   - aether toolchain version (so an `ae` upgrade busts every entry)
//
// Returns ("", err) on read failure of any hashed file — caller
// treats that as cache-miss (uncacheable build) and falls through.
_cache_key_for_aether_link(builder_map: ptr, source_dir: string, src_path: string, lib_dir: string, dup_flag: string, shared_libs_text: string) {
    parts = list.new()

    // Toolchain version
    list.add(parts, string.concat("ae:", _toolchain_version()))

    // Toolchain *content*, not just the version string. `ae --version`
    // reports the last release tag — unchanged for a toolchain rebuilt
    // from source between tags — so the version string alone yields a
    // false cache hit after such a rebuild (filed by the avn project:
    // a compiler fix landed as a HEAD commit past the release tag).
    // Hash the compiler binary and the runtime archive so any rebuild,
    // released or not, busts the key. The file.exists guards never
    // skip in a real build: the builder resolves aetherc to run it,
    // and validates lib_dir (a non-existent libaether.a aborts the
    // build earlier) — they only tolerate synthetic test inputs.
    // This also makes the import-closure scan's stdlib/contrib skip
    // correct: a stdlib .ae change ships inside the rebuilt
    // libaether.a, whose hash now moves the key.
    // .exe on Windows — same suffix rule as the compile step's `aetherc`.
    // Without it `file.exists` is 0 on Windows and the compiler's content
    // silently drops OUT of the cache key, so a rebuilt-from-source toolchain
    // would serve stale binaries there. The guard reads as "tolerating
    // synthetic test inputs"; it must not quietly mean "always skip on
    // Windows". (asks/windows-fanout-aetherc-invoked-as-directory.md)
    aetherc_bin = path.join(_resolve_aether_dir(), string.concat("aetherc", bldr._exe_suffix()))
    if file.exists(aetherc_bin) == 1 {
        ach, acherr = cache.hash_file(aetherc_bin)
        if string.length(acherr) > 0 {
            return "", acherr
        }
        list.add(parts, string.concat("aetherc-hash:", ach))
    }
    libaether_a = string.concat(lib_dir, "/libaether.a")
    if file.exists(libaether_a) == 1 {
        lah, laherr = cache.hash_file(libaether_a)
        if string.length(laherr) > 0 {
            return "", laherr
        }
        list.add(parts, string.concat("libaether-hash:", lah))
    }

    // Main source content
    src_hash, herr = cache.hash_file(src_path)
    if string.length(herr) > 0 {
        return "", herr
    }
    list.add(parts, string.concat("src:", src_path))
    list.add(parts, string.concat("src-hash:", src_hash))

    // Transitive Aether import closure — every project .ae the entry
    // pulls in via `import`, directly or indirectly. Without this a
    // change to a widely-imported module (avn's repo_storage was the
    // motivating case) never busts a consumer's key. `import` modules
    // are resolved against source_dir and its ancestor directories.
    imp_roots = _ancestor_dirs(source_dir)
    imps = _transitive_import_aes(src_path, imp_roots)
    nimp = list.size(imps)
    iidx = 0
    impf = ""
    imph = ""
    impe = ""
    while iidx < nimp {
        impf, _ = list.get(imps, iidx)
        imph, impe = cache.hash_file(impf)
        if string.length(impe) > 0 {
            return "", impe
        }
        list.add(parts, string.concat("import:", impf))
        list.add(parts, string.concat("import-hash:", imph))
        iidx = iidx + 1
    }

    // Extra sources (final post-regen list). Each entry: path + hash.
    if builder_map != null {
        if map.has(builder_map, "extra_source") == 1 {
            extras, _ = map.get(builder_map, "extra_source")
            ne = list.size(extras)
            ie = 0
            while ie < ne {
                ef, _ = list.get(extras, ie)
                resolved = ef
                if string.length(ef) > 0 {
                    _absq = _is_abs_path(ef)
                    if _absq == 0 {
                        resolved = path.join(source_dir, ef)
                    }
                }
                eh, eerr = cache.hash_file(resolved)
                if string.length(eerr) > 0 {
                    return "", eerr
                }
                list.add(parts, string.concat("extra:", resolved))
                list.add(parts, string.concat("extra-hash:", eh))
                ie = ie + 1
            }
        }
    }

    // Extra include dirs (user include_dir + dep c_header_dirs), resolved
    // and stashed on the builder by _compile_and_link. Hash the dir paths
    // AND the files directly inside them, so a regenerated header (e.g. a
    // generated data table a dep published) busts the consumer's key.
    // Best-effort per file: a non-hashable entry (a subdirectory, an
    // unreadable file) is skipped rather than failing the whole key —
    // the dir-path part still moves the key on structural changes.
    if builder_map != null {
        if map.has(builder_map, "_resolved_inc_dirs") == 1 {
            inc_dirs, _ = map.get(builder_map, "_resolved_inc_dirs")
            nid = list.size(inc_dirs)
            idi = 0
            while idi < nid {
                idd, _ = list.get(inc_dirs, idi)
                idi = idi + 1
                list.add(parts, string.concat("incdir:", idd))
                matches, _gie = fs.glob(string.concat(idd, "/*"))
                if matches != null {
                    mc = dir_list_count(matches)
                    mi = 0
                    while mi < mc {
                        mf = dir_list_get(matches, mi)
                        mi = mi + 1
                        ih, ihe = cache.hash_file(mf)
                        if string.length(ihe) == 0 {
                            list.add(parts, string.concat("incfile:", string.concat(mf, "")))
                            list.add(parts, string.concat("incfile-hash:", ih))
                        }
                    }
                    dir_list_free(matches)
                }
            }
        }
    }

    // Link flags, in declared order.
    if builder_map != null {
        if map.has(builder_map, "link_flag") == 1 {
            flags, _ = map.get(builder_map, "link_flag")
            nf = list.size(flags)
            jf = 0
            while jf < nf {
                ff, _ = list.get(flags, jf)
                list.add(parts, string.concat("flag:", ff))
                jf = jf + 1
            }

            // ...and the CONTENT of the archives those -L/-l flags resolve
            // to, so a same-path toolchain/library swap busts the key (see
            // _link_flag_lib_files). Each resolved file: path + content
            // hash. A read failure here is a cache-miss (uncacheable), same
            // as every other hashed input in this function.
            lib_files = _link_flag_lib_files(flags, source_dir)
            nlf = list.size(lib_files)
            lfi = 0
            while lfi < nlf {
                lff, _ = list.get(lib_files, lfi)
                lfi = lfi + 1
                lfh, lfe = cache.hash_file(lff)
                if string.length(lfe) > 0 {
                    return "", lfe
                }
                list.add(parts, string.concat("linklib:", lff))
                list.add(parts, string.concat("linklib-hash:", lfh))
            }
        }

        // Per-node lib() dirs: hash the dir path AND the .ae modules directly
        // inside (so a changed sibling module on the lib path busts the key —
        // the transitive-import scan resolves against source_dir/ancestors, not
        // these extra lib dirs, so it wouldn't otherwise see them). Mirrors the
        // include_dir contribution above.
        if map.has(builder_map, "lib") == 1 {
            lib_dirs = _node_lib_dirs(builder_map, source_dir)
            nld = list.size(lib_dirs)
            ldi = 0
            while ldi < nld {
                ldd, _ = list.get(lib_dirs, ldi)
                ldi = ldi + 1
                list.add(parts, string.concat("libdir:", ldd))
                lmatches, _gle = fs.glob(string.concat(ldd, "/*.ae"))
                if lmatches != null {
                    lmc = dir_list_count(lmatches)
                    lmi = 0
                    while lmi < lmc {
                        lmf = dir_list_get(lmatches, lmi)
                        lmi = lmi + 1
                        lh, lhe = cache.hash_file(lmf)
                        if string.length(lhe) == 0 {
                            list.add(parts, string.concat("libfile:", string.concat(lmf, "")))
                            list.add(parts, string.concat("libfile-hash:", lh))
                        }
                    }
                    dir_list_free(lmatches)
                }
            }
        }
    }

    // Shared-lib deps (cross-language outputs, e.g. Rust cdylibs).
    // shared_libs_text is newline-separated; each line is a path.
    if string.length(shared_libs_text) > 0 {
        rest = shared_libs_text
        while string.length(rest) > 0 {
            nl = string.index_of(rest, "\n")
            line = ""
            if nl < 0 {
                line = rest
                rest = ""
            } else {
                line = string.substring(rest, 0, nl)
                rest = string.substring(rest, nl + 1, string.length(rest))
            }
            if string.length(line) > 0 {
                sh, serr = cache.hash_file(line)
                if string.length(serr) > 0 {
                    return "", serr
                }
                list.add(parts, string.concat("shared:", line))
                list.add(parts, string.concat("shared-hash:", sh))
            }
        }
    }

    // Toolchain layout + platform flag.
    list.add(parts, string.concat("lib-dir:", lib_dir))
    list.add(parts, string.concat("dup-flag:", dup_flag))

    // Coverage flag — instrumented builds produce different output
    // bytes than uninstrumented ones, must not share cache entries.
    cov = ""
    if string.length(os.getenv("AEB_COVERAGE")) > 0 { cov = "1" }
    list.add(parts, string.concat("coverage:", cov))

    digest, derr = cache.hash_inputs(parts)
    return digest, derr
}

// Returns 1 if the user declared extra_source(...) or link_flag(...)
// in the builder block — i.e. wants the manual gcc path. Returns 0
// otherwise (default: shell out to `ae build`). Takes the builder
// map as a parameter because `_builder` is only in scope inside
// `builder` functions, not regular helpers.
_has_manual_overrides(builder_map: ptr) {
    if builder_map == null { return 0 }
    if map.has(builder_map, "extra_source") == 1 { return 1 }
    if map.has(builder_map, "extra_source_glob") == 1 { return 1 }
    if map.has(builder_map, "link_flag") == 1 { return 1 }
    if map.has(builder_map, "include_dir") == 1 { return 1 }
    if map.has(builder_map, "regen") == 1 { return 1 }
    if map.has(builder_map, "no_closure_regen") == 1 { return 1 }
    return 0
}

// --- Include dirs for the gcc compile (Gap 1) -----------------------
//
// Two sources of `-I` dirs beyond the Aether runtime include root:
//   1. user include_dir(...) entries (relative → source_dir),
//   2. dependencies' published `c_header_dirs` artifact (the same key
//      c.generated_header writes and c.program consumes).
// Both feed one resolved dir list, used to build the `-I` flag block
// AND (stashed on the builder) to hash into the cache key.

// Resolved user include_dir entries (absolute paths). Empty list when
// none declared.
// _is_abs_path(p) — is `p` absolute, on any host we build on?
//
// POSIX: a leading "/". Windows: a drive-letter prefix ("C:/" or "C:\\"),
// and UNC ("\\\\server\\share"). MSYS presents its own paths as "/c/...",
// which the POSIX arm already covers.
//
// Every "relative → source_dir, absolute passes through" site must use
// this. Testing only for "/" silently treats "C:/Users/..." as relative and
// joins it to source_dir, producing "<dir>/C:/Users/..." — a path that
// cannot exist, and which gcc reports as `Invalid argument` rather than
// anything pointing at the build system. That cost the aether-ui line a
// whole platform (see asks/windows-absolute-paths-joined-to-source-dir.md).
//
// Delegates to the single canonical predicate in lib/build so the rule lives
// in exactly one place; the local wrapper is kept because callers here invoke
// it bare (dozens of sites) and to preserve the ask-doc trail above.
_is_abs_path(p: string) {
    return bldr._is_abs_path(p)
}

_resolved_user_include_dirs(builder_map: ptr, source_dir: string) {
    out = list.new()
    if builder_map == null { return out }
    if map.has(builder_map, "include_dir") == 0 { return out }
    dirs, _ = map.get(builder_map, "include_dir")
    n = list.size(dirs)
    i = 0
    while i < n {
        d, _ = list.get(dirs, i)
        rd = d
        if string.length(d) > 0 {
            if _is_abs_path(d) == 0 {
                rd = path.join(source_dir, d)
            }
        }
        list.add(out, rd)
        i = i + 1
    }
    return out
}

// _node_lib_dirs(builder_map, source_dir) — the node's lib() dirs, resolved
// (relative → source_dir, absolute passthrough), as a list. Mirrors the
// include_dir collector above. Used both for the aetherc --lib flags and the
// cache key (so a changed lib path invalidates the link).
_node_lib_dirs(builder_map: ptr, source_dir: string) {
    out = list.new()
    if builder_map == null { return out }
    if map.has(builder_map, "lib") == 0 { return out }
    dirs, _ = map.get(builder_map, "lib")
    n = list.size(dirs)
    i = 0
    while i < n {
        d, _ = list.get(dirs, i)
        rd = d
        if string.length(d) > 0 {
            if _is_abs_path(d) == 0 {
                rd = path.join(source_dir, d)
            }
        }
        list.add(out, rd)
        i = i + 1
    }
    return out
}

// _node_lib_flags(builder_map, source_dir) — the repeated " --lib <dir>"
// fragment for the node's lib() dirs (resolved). "" when none. Repeated flags
// (not a joined value) keep it Windows-shell-safe, matching _ae_build_lib_flags.
_node_lib_flags(builder_map: ptr, source_dir: string) {
    dirs = _node_lib_dirs(builder_map, source_dir)
    out = ""
    n = list.size(dirs)
    i = 0
    while i < n {
        d, _ = list.get(dirs, i)
        out = string.concat(out, string.concat(" --lib ", d))
        i = i + 1
    }
    return out
}

// Raw include dirs published by deps via the `c_header_dirs` artifact
// (mirrors lib/c's _collect_dep_header_dirs, but returns the dir list
// rather than a -I string so the dirs can also be hashed).
_collect_dep_header_dirs(ctx: ptr) {
    out = list.new()
    deps, _ = map.get(ctx, "deps")
    n = list.size(deps)
    i = 0
    while i < n {
        dp, _ = list.get(deps, i)
        i = i + 1
        dm = bldr._strip_lang(dp)
        dirs = bldr._read_dep_artifact(ctx, dm, "c_header_dirs")
        if string.length(dirs) > 0 {
            lines = string.split(dirs, "\n")
            m = string.array_size(lines)
            j = 0
            while j < m {
                d = string.array_get(lines, j)
                j = j + 1
                t = string.trim(d)
                if string.length(t) > 0 { list.add(out, t) }
            }
            string.array_free(lines)
        }
    }
    return out
}

// User include dirs + dep header dirs, resolved, in one list.
_all_extra_include_dirs(ctx: ptr, builder_map: ptr, source_dir: string) {
    out = _resolved_user_include_dirs(builder_map, source_dir)
    dep_dirs = _collect_dep_header_dirs(ctx)
    n = list.size(dep_dirs)
    i = 0
    while i < n {
        d, _ = list.get(dep_dirs, i)
        list.add(out, d)
        i = i + 1
    }
    return out
}

// " -I'<dir>'" block for a resolved dir list. Pure.
// _inc_flags_from_lines(text) — newline-separated dir list -> " -I'<dir>'" run.
// The resolved-in-aeb replacement for `$(find … | sed 's|^|-I|')`: that form
// needed a POSIX shell to expand the substitution AND to survive the embedded
// single quotes, and cmd.exe can do neither, so on MSYS2 the -I block came out
// mangled or empty. Quoting each dir also makes a space-in-path install work,
// which the sed form never did.
// (asks/windows-pkg-config-substitution-runs-in-cmd.md)
// _flags_from_lines(text) — newline-separated, ALREADY-PREFIXED flags joined
// into one run. The find pipeline's sed emits `-I<dir>` per line, so this only
// joins; it must not prefix again. (Twin of aeb-link's _flags_from_lines_link.)
_flags_from_lines(text: string) {
    out = ""
    rest = text
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        line = ""
        if nl < 0 {
            line = rest
            rest = ""
        } else {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        f = string.trim(line)
        if string.length(f) > 0 {
            out = string.concat(out, string.concat(" ", f))
        }
    }
    return out
}

_inc_flags_from_lines(text: string) {
    out = ""
    rest = text
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        line = ""
        if nl < 0 {
            line = rest
            rest = ""
        } else {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        d = string.trim(line)
        if string.length(d) > 0 {
            out = string.concat(out, " -I'")
            out = string.concat(out, d)
            out = string.concat(out, "'")
        }
    }
    return out
}

_inc_flags_from_dirs(dirs: ptr) {
    out = ""
    n = list.size(dirs)
    i = 0
    while i < n {
        d, _ = list.get(dirs, i)
        if string.length(d) > 0 {
            out = string.concat(out, " -I'")
            out = string.concat(out, d)
            out = string.concat(out, "'")
        }
        i = i + 1
    }
    return out
}

// Default build path: shell out to `ae build`. Lets the Aether driver
// apply its own logic — aether.toml [[bin]] lookup (extra_sources +
// link_flags), final link, and its own up-to-date cache.
//
// What `ae build` does NOT do: regen .ae→_generated.c. It treats every
// extra_sources entry as a path that must already exist on disk. To
// drive codegen-then-link from a single .build.ae, declare the
// generated sources via `regen("foo.ae")` in the builder block —
// that opts into the manual path below, which runs aetherc per .ae
// and then links.
//
// `ae build` walks up from src_path to find aether.toml, so aeb
// doesn't need to discover it.
// _rewrite_under_root(p, root, mountpt) — map a host-absolute path under
// `root` to its location under `mountpt` (the container's bind target).
// "/home/u/repo/foo/bar" with root "/home/u/repo", mount "/work" → "/work/foo/bar".
// Returns p unchanged if it isn't under root (defensive). Pure.
_rewrite_under_root(p: string, root: string, mountpt: string) {
    if string.index_of(p, root) != 0 { return p }
    rest = string.substring(p, string.length(root), string.length(p))
    return string.concat(mountpt, rest)
}

// _ae_build_cmd_delegated(ae_build_args, root, image) — wrap an `ae build …`
// command (paths already rewritten to /work) in a `podman run` against the
// toolchain image. The image's ENTRYPOINT expects --aeb-style args, so we
// override it and invoke `ae` directly. root is bind-mounted at /work (:Z for
// SELinux; the container writes target/ back through the mount → artifacts +
// cache markers reach the host with mtimes intact). Pure string assembly —
// unit-tested via tests/test_compile_delegation.ae.
_ae_build_cmd_delegated(ae_build_args: string, root: string, image: string, workdir: string) {
    engine = os.getenv("AEB_CONTAINER_ENGINE")
    if string.length(engine) == 0 { engine = "podman" }
    selabel = os.getenv("AEB_CONTAINER_SELABEL")
    if string.length(selabel) == 0 { selabel = "Z" }
    mount = string.concat(string.concat("-v ", root), string.concat(":/work:", selabel))
    // -w <workdir>: run from the module's source dir (rewritten to /work/…) so
    // `ae build` finds that module's aether.toml (ae reads "aether.toml" from
    // CWD). Empty workdir → /work (repo root), the prior behavior.
    wd = workdir
    if string.length(wd) == 0 { wd = "/work" }
    // --entrypoint ae: bypass the image's aether-build dispatcher, run ae
    // directly. Args are the `build …` portion (entrypoint supplies the prog).
    cmd = string.concat(engine, " run --rm ")
    cmd = string.concat(cmd, mount)
    cmd = string.concat(cmd, string.concat(string.concat(" -w ", wd), " --entrypoint ae "))
    cmd = string.concat(cmd, image)
    cmd = string.concat(cmd, " ")
    cmd = string.concat(cmd, ae_build_args)
    return cmd
}

// _ae_build_lib_flags(compile_lib) — turn a separator-joined AEB_COMPILE_LIB
// value (<a><sep><b>…, sep = bldr._path_sep(): ':' POSIX / ';' Windows) into a
// repeated-flag fragment " --lib a --lib b". Empty in → "". Repeated flags (not
// a joined --lib value) keep it Windows-shell-safe (aetherc's first --lib resets
// the chain, each subsequent appends). Pure string assembly.
// _pkg_config_libs(module) — resolved `--libs` for ONE pkg-config module, or
// "" when it has no .pc. Runs pkg-config NOW, through the chokepoint, and
// returns literal flags; the caller splices text, never `$(...)`.
//
// One invocation per module (d55f064): `pkg-config --libs a b` is
// all-or-nothing, so a missing a.pc silently drops b's flags too.
_pkg_config_libs(mod: string) {
    out, err = bldr._sh_capture("pkg-config --libs ${mod} 2>/dev/null")
    if string.length(err) > 0 { return "" }
    return string.trim(out)
}

// _resolve_sysdeps() — the literal `-l…` run for libaether's external deps,
// resolved in aeb rather than emitted as shell substitution.
//
// THREE things this fixes, all measured on winbaz
// (asks/windows-pkg-config-substitution-runs-in-cmd.md):
//
//  1. `$(pkg-config …)` embedded in the gcc string is only substituted if a
//     POSIX shell runs that string. On MSYS2 it reached cmd.exe, which cannot
//     do it — so the flags were ABSENT, not wrong, and the link failed on
//     undefined deflate/EVP_*/pcre2_* with pkg-config's own stderr swallowed
//     by a `2>/dev/null` cmd.exe never interpreted. Resolving here is
//     shell-agnostic.
//  2. pcre2 was missing from the list. libaether.a references pcre2_* from
//     aether_regex.o alongside zlib and openssl, so even a correct
//     substitution on a correct search path still failed to link.
//  3. On MSYS2 the pkg-config on PATH is /usr/bin/pkg-config, which searches
//     /usr/lib/pkgconfig — while the 183 .pc files live in
//     /mingw64/lib/pkgconfig. Seed PKG_CONFIG_PATH with the mingw64 tree on
//     Windows so the lookup finds them. Appended, never replacing: an
//     operator-set PKG_CONFIG_PATH keeps priority.
//
// A module with no .pc contributes nothing rather than voiding the set. That
// is the right default: if libaether was built without a dep, it does not
// reference its symbols either.
_resolve_sysdeps() {
    if bldr._is_windows() == 1 {
        existing = os.getenv("PKG_CONFIG_PATH")
        mingw = "/mingw64/lib/pkgconfig"
        if string.length(existing) == 0 {
            _sp = os.setenv("PKG_CONFIG_PATH", mingw)
        } else {
            if string.index_of(existing, mingw) < 0 {
                _sp2 = os.setenv("PKG_CONFIG_PATH", string.concat(existing, string.concat(bldr._path_sep(), mingw)))
            }
        }
    }
    out = ""
    mods = list.new()
    list.add(mods, "zlib")
    list.add(mods, "openssl")
    list.add(mods, "libpcre2-8")
    n = list.size(mods)
    i = 0
    while i < n {
        m, _ = list.get(mods, i)
        flags = _pkg_config_libs(m)
        if string.length(flags) > 0 {
            out = string.concat(out, string.concat(" ", flags))
        }
        i = i + 1
    }
    return out
}

_ae_build_lib_flags(compile_lib: string) {
    if string.length(compile_lib) == 0 { return "" }
    sep = bldr._path_sep()
    out = ""
    rest = compile_lib
    while string.length(rest) > 0 {
        idx = string.index_of(rest, sep)
        entry = ""
        if idx < 0 {
            entry = rest
            rest = ""
        } else {
            entry = string.substring(rest, 0, idx)
            rest = string.substring(rest, idx + string.length(sep), string.length(rest))
        }
        if string.length(entry) > 0 {
            out = string.concat(out, string.concat(" --lib ", entry))
        }
    }
    return out
}

// emit_flags: "" for a normal binary build; a pre-spaced flag run
// (e.g. " --emit=csrc --with=net" from ae_csrc_flags) for emit-mode
// builds where -o is an output BASE, not a binary path.
_shell_out_ae_build(ctx: ptr, builder_map: ptr, src_path: string, bin_path: string, emit_flags: string) {
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")
    ae_bin = _ae_bin()

    // Coverage: cross-cutting CLI flag set by the trampoline as
    // AEB_COVERAGE=1. When on, append `--coverage` to ae build,
    // which (per Aether 0.115) injects `gcc --coverage` and forces
    // -O0 -g for accurate .ae.gcov line attribution. Suppressed for
    // emit-mode builds: --coverage instruments the gcc step, and
    // e.g. --emit=csrc never runs gcc — the flag would be at best a
    // no-op riding into a source-only artifact.
    cov_flag = ""
    if string.length(os.getenv("AEB_COVERAGE")) > 0 {
        if string.length(emit_flags) == 0 {
            cov_flag = " --coverage"
        }
    }

    // Cross-compile triple (target()). "" for a host build. Threaded into
    // both the local and container-delegated `ae build` command lines below,
    // right after "build" like emit_flags/cov_flag. ae keys its own
    // incremental cache on the triple, so no aeb cache-key change is needed
    // (this path already reports [n/a]).
    tgt_flag = _target_flag(builder_map)

    // Thread the orchestrator's module search path (AEB_COMPILE_LIB, set by
    // tools/aeb-link as <aeb_lib>:<repo_root>) onto this `ae build` as repeated
    // `--lib` flags. Without it, a program that imports an SDK module from lib/
    // (e.g. tools/aeb-agent: `import agent` / `import veto` / `import build`)
    // fails with E0301 — `ae build` only searches cwd + --lib, and the imported
    // modules live under the repo's lib/, not the source dir. The
    // _compile_and_link path already threads this; the default shell-out path
    // (here) did not — which is why the aeb-agent dogfood build
    // (tools/agent/.dist.ae) was broken (asks/agent-dist-dogfood-broken.md).
    // Repeated flags (not a `;`/`:`-joined value) so it's Windows-shell-safe
    // (the cmd.exe∘sh quoting law — see lib/build's _sh).
    lib_flags = _ae_build_lib_flags(os.getenv("AEB_COMPILE_LIB"))
    // Per-node lib() dirs (appended after the env path, so a node only ADDS).
    // See asks/aether-program-per-node-lib-search-path.md.
    lib_flags = string.concat(lib_flags, _node_lib_flags(builder_map, source_dir))

    // COMPILE-DELEGATION (docs/design/two-aeb-duality.md): when AEB_COMPILE_CONTAINER
    // names a toolchain image, this compile step runs IN that container
    // (host-aeb has no toolchain) rather than locally. Paths are rewritten
    // from root/… to /work/… (root is bind-mounted at /work). Unset → today's
    // local `ae build`, unchanged for normal hosts.
    container_image = os.getenv("AEB_COMPILE_CONTAINER")
    if string.length(container_image) > 0 {
        root = bldr._get(ctx, "root")
        wsrc = _rewrite_under_root(src_path, root, "/work")
        wbin = _rewrite_under_root(bin_path, root, "/work")
        // Run `ae build` from the module's source dir IN the container so it
        // finds the module's aether.toml (ae reads "aether.toml" from CWD). The
        // in-container source dir is the source dir rewritten root/… → /work/….
        wsrcdir = _rewrite_under_root(bldr._get(ctx, "source_dir"), root, "/work")
        // NB: lib_flags carry host paths; inside the container they're rewritten
        // root/… → /work/… so the SDK lib resolves at the bind-mounted location.
        wlibs = _rewrite_under_root(lib_flags, root, "/work")
        args = "build${cov_flag}${tgt_flag}${emit_flags} ${wsrc} -o ${wbin}${wlibs}"
        cmd = _ae_build_cmd_delegated(args, root, container_image, wsrcdir)
        rc = bldr._sh(cmd)
        if rc != 0 {
            println("${mod_dir}: ae build (in ${container_image}) failed")
            bldr.fail(ctx, "ae build (containerized) failed")
            return rc
        }
        // Same delegation as the local path below — the toolchain in the
        // container owns the staleness decision, so aeb reports "n/a".
        bldr._record_cache(ctx, "n/a")
        return 0
    }

    // Run from the module's source dir so `ae build` finds its aether.toml
    // (ae reads a bare "aether.toml" relative to CWD — see tools/ae.c). src_path
    // and bin_path are absolute, so they still resolve after the cd; the cd only
    // affects where aether.toml ([build] cflags/link_flags) is picked up. The
    // first target to actually need this was hosttinygo (link_flags = "-lffi"
    // for the libffi-using tinygo bridge); the other bridges had empty tomls.
    // (source_dir read at the top of this fn.)
    cmd = "cd ${source_dir} && ${ae_bin} build${cov_flag}${tgt_flag}${emit_flags} ${src_path} -o ${bin_path}${lib_flags}"
    rc = bldr._sh(cmd)
    if rc != 0 {
        println("${mod_dir}: ae build failed")
        bldr.fail(ctx, "ae build failed")
        return rc
    }
    // This path delegates staleness to `ae build`'s own incremental cache, so
    // aeb has no cache decision to report — "n/a" is exactly what the marker
    // vocabulary means by that. Recording nothing left `_read_cache_outcome`
    // to default a MISSING marker to "n/a" too, which happened to render the
    // same; but then every `aether.program` on the default path printed a
    // marker it had never written, and a genuine miss was indistinguishable
    // from "this SDK does not cache". Say it explicitly.
    bldr._record_cache(ctx, "n/a")
    return 0
}

// ae_csrc_flags(caps) — the pre-spaced `ae build` flag run for a
// C-source-package build (aether 0.357 --emit=csrc): " --emit=csrc"
// plus " --with=<caps>" when a capability csv is declared. The
// leading space is part of the contract — the caller splices it
// directly after "build" in the command line. Pure: no I/O.
// Tested in tests/test_aether_csrc_cmd.ae.
ae_csrc_flags(caps: string) {
    flags = " --emit=csrc"
    if string.length(caps) > 0 {
        flags = string.concat(flags, " --with=")
        flags = string.concat(flags, caps)
    }
    return flags
}

// ae_lib_flags(caps, builder_map, source_dir) — the pre-spaced `ae build` flag
// run for a shared-library build (--emit=lib): " --emit=lib", plus " --with=<caps>"
// and one " --extra <path>" per extra_source(...) (resolved against source_dir;
// absolute passes through). Mirrors ae_csrc_flags but folds in extra C sources,
// which --emit=lib links into the .so (the engine's _embed_support.c etc.).
// The shell-out path (which shared_lib uses) does not thread extra_source on its
// own — csrc/program's manual path does — so it is threaded here as ae's own
// --extra flag. Pure string work.
ae_lib_flags(caps: string, builder_map: ptr, source_dir: string) {
    flags = " --emit=lib"
    if string.length(caps) > 0 {
        flags = string.concat(flags, string.concat(" --with=", caps))
    }
    if builder_map != null {
        // size() opt-in — size-optimize + strip (matches release/build.sh's --size).
        if map.has(builder_map, "lib_size") == 1 {
            flags = string.concat(flags, " --size")
        }
    }
    if builder_map != null {
        if map.has(builder_map, "extra_source") == 1 {
            extras, _ = map.get(builder_map, "extra_source")
            ne = list.size(extras)
            ie = 0
            while ie < ne {
                ef, _ = list.get(extras, ie)
                resolved = ef
                if string.length(ef) > 0 {
                    if _is_abs_path(ef) == 0 { resolved = path.join(source_dir, ef) }
                }
                flags = string.concat(flags, string.concat(" --extra ", resolved))
                ie = ie + 1
            }
        }
    }
    return flags
}

// csrc_default_output(src_name) — default output base for an
// aether.csrc node: the source name minus a trailing ".ae"
// ("greet.ae" → "greet"); a name without the suffix passes through
// unchanged. Pure. Tested in tests/test_aether_csrc_cmd.ae.
csrc_default_output(src_name: string) {
    n = string.length(src_name)
    if n > 3 {
        if string.ends_with(src_name, ".ae") == 1 {
            return string.substring(src_name, 0, n - 3)
        }
    }
    return string.concat(src_name, "")
}

// Build the aetherc command for codegen-mode (--emit=lib) compilation
// of an .ae source. `caps` is a comma-separated capability list
// (e.g. "net,fs"); empty → no --with= flag is emitted. `lib_flags` is a
// pre-assembled repeated-flag fragment (" --lib a --lib b", from
// _node_lib_flags); empty → none. Without it, a regen'd module that
// imports project modules from a node's lib() dir fails E0301 because
// aetherc searches only cwd + --lib. Pure: no I/O, just string assembly.
// Tested in tests/test_aether_cmd.ae.
aetherc_emit_lib_cmd(aetherc: string, ae_path: string, c_path: string, caps: string, lib_flags: string) {
    with_flag = ""
    if string.length(caps) > 0 {
        with_flag = " --with=${caps}"
    }
    return "${aetherc} --emit=lib${with_flag}${lib_flags} ${ae_path} ${c_path}"
}

// Build the gcc link command for the manual aether.program path.
// Pure: takes already-resolved strings via an opts map and assembles
// them. Tested in tests/test_aether_link_cmd.ae.
//
// Required keys in opts:
//   c_path      — generated .c for the program's main .ae source
//   bin_path    — output binary path
//   lib_dir     — dir containing libaether.a (-L)
//   inc_flags   — leading-space-prefixed -I block (or "")
//   extras_str  — leading-space-prefixed list of extra .c paths (or "")
//   extra_link  — shared-library deps (space-separated, no leading space)
//   rpath_link  — -Wl,-rpath,... entries (space-separated, no leading space)
//   user_flags  — leading-space-prefixed user link_flag entries (or "")
//   dup_flag    — duplicate-symbol linker flag (platform-dependent)
//   coverage    — "1" to inject `--coverage -O0 -g` (replaces the
//                 default -O2); empty string for normal build. -O0
//                 is required for accurate .ae.gcov line attribution
//                 since gcc at -O2 inlines and merges blocks (per
//                 the Aether 0.115 changelog note on `ae build
//                 --coverage`).
aether_link_cmd(opts: ptr) {
    c_path, _      = map.get(opts, "c_path")
    bin_path, _    = map.get(opts, "bin_path")
    lib_dir, _     = map.get(opts, "lib_dir")
    inc_flags, _   = map.get(opts, "inc_flags")
    extras_str, _  = map.get(opts, "extras_str")
    extra_link, _  = map.get(opts, "extra_link")
    rpath_link, _  = map.get(opts, "rpath_link")
    user_flags, _  = map.get(opts, "user_flags")
    dup_flag, _    = map.get(opts, "dup_flag")
    coverage = ""
    if map.has(opts, "coverage") == 1 {
        coverage, _ = map.get(opts, "coverage")
    }
    // Optimization level: -O2 normally, -O0 -g for coverage builds
    // so .gcda → .ae.gcov line attribution stays accurate.
    opt_flags = "-O2"
    cov_flag = ""
    if string.equals(coverage, "1") == 1 {
        opt_flags = "-O0 -g"
        cov_flag = " --coverage"
    }
    // libaether.a unconditionally references zlib/openssl/pcre2 symbols when
    // the Aether toolchain was built with them detected (most distros). The
    // flags arrive here ALREADY RESOLVED — as literal `-lz -lssl …` text, not
    // as `$(pkg-config …)` for a shell to expand. See _resolve_sysdeps.
    //
    // Emitting the substitution was portable only as long as a POSIX shell ran
    // the string; on MSYS2 it reached cmd.exe, which cannot perform `$(...)`
    // or honour `2>/dev/null`, so the flags came out ABSENT rather than wrong
    // and the link died on undefined deflate/EVP_*/pcre2_* with nothing
    // pointing at why. Resolving in aeb is shell-agnostic and lets a missing
    // .pc be reported instead of failing opaquely at link time.
    // (asks/windows-pkg-config-substitution-runs-in-cmd.md)
    sysdeps = ""
    if map.has(opts, "sysdeps") == 1 {
        sysdeps, _ = map.get(opts, "sysdeps")
    }
    // Module-declared @link libs (leading-space run, or "") and the dev-layout
    // contrib -L (or ""), both resolved by the caller from the generated C's
    // `// aether-link:` header. Placed BEFORE user_flags so a consumer's
    // explicit link_flag() keeps override authority. Empty in the common case.
    aether_link = ""
    if map.has(opts, "aether_link") == 1 { aether_link, _ = map.get(opts, "aether_link") }
    contrib_L = ""
    if map.has(opts, "contrib_L") == 1 { contrib_L, _ = map.get(opts, "contrib_L") }
    return "gcc ${opt_flags} -pipe -w${cov_flag}${inc_flags} ${c_path}${extras_str} -L${lib_dir}${contrib_L} -laether ${extra_link} ${rpath_link}${aether_link}${user_flags} -o ${bin_path} -pthread -lm${sysdeps} ${dup_flag}"
}

// Decide whether a regen entry needs aetherc work, given the .ae and
// .c mtimes (0 = file does not exist; otherwise unix timestamp).
// Returns one of:
//   "missing"  — .c file does not exist; must regenerate
//   "stale"    — .c older than .ae; must regenerate
//   "skip"     — .c is fresh; no work
// Pure: just integer comparisons. Tested in tests/test_aether_helpers.ae.
//
// This helper is deliberately mtime-only and knows nothing about the
// toolchain. Toolchain-staleness — regenerating when aetherc itself
// is newer than the .c — is handled by the *caller* `_run_regen_pass`
// (it upgrades a "skip" to "toolchain"). Don't read this function in
// isolation and conclude the regen pass is toolchain-blind; it isn't.
_regen_action(ae_mtime: int, c_mtime: int) {
    if c_mtime == 0 { return "missing" }
    if c_mtime < ae_mtime { return "stale" }
    return "skip"
}

// Replace .ae extension with _generated.c. "foo/bar.ae" → "foo/bar_generated.c".
// Returns "" if path doesn't end in .ae.
_paired_generated_c(ae_path: string) {
    n = string.length(ae_path)
    if n < 3 { return "" }
    suffix = string.substring(ae_path, n - 3, n)
    if string.equals(suffix, ".ae") == 0 { return "" }
    stem = string.substring(ae_path, 0, n - 3)
    return string.concat(stem, "_generated.c")
}

// Encode a path into a flat, collision-free filename fragment: every
// non-[A-Za-z0-9] byte becomes '_'. Because the *whole* (absolute) path
// is encoded, two same-basename sources in different dirs can't collide.
// Pure. "/proj/ae/foo.ae" → "_proj_ae_foo_ae".
_encode_path_for_filename(p: string) {
    keep = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    out = ""
    n = string.length(p)
    i = 0
    while i < n {
        ch = string.substring(p, i, i + 1)
        if string.index_of(keep, ch) >= 0 {
            out = string.concat(out, ch)
        } else {
            out = string.concat(out, "_")
        }
        i = i + 1
    }
    return out
}

// Out-of-tree path for a regen'd source's generated C: under
// <target_dir>/regen/, named from the encoded absolute .ae path so it
// never collides and never lands next to committed source (Gap 2). Pure
// (string assembly only). The caller mkdir's <target_dir>/regen.
_regen_target_c(target_dir: string, ae_abs: string) {
    fname = string.concat(_encode_path_for_filename(ae_abs), "_generated.c")
    return path.join(path.join(target_dir, "regen"), fname)
}

// Scan an .ae source for `import std.X` lines and return a comma-
// separated capability list suitable for `aetherc --with=...`.
//
// Mapping (from aetherc's --emit=lib gating, verified against
// ae 0.111):
//   import std.http | std.tcp | std.net  → net
//   import std.fs                        → fs
//   import std.os                        → os
//
// Imports through transitive modules aren't seen — caller falls
// back to regen_with(path, "net,fs,...") for those. Returns "" when
// no cap-bearing import is detected.
_detect_caps(ae_path: string) {
    content, _err = fs.read(ae_path)
    return _detect_caps_from_content(content)
}

// Pure helper — same logic as _detect_caps, but takes the source
// content directly. Split out so unit tests can exercise the
// import→cap mapping without touching the filesystem.
_detect_caps_from_content(content: string) {
    if string.length(content) == 0 { return "" }
    has_net = 0
    has_fs = 0
    has_os = 0
    if string.index_of(content, "import std.http") >= 0 { has_net = 1 }
    if string.index_of(content, "import std.tcp")  >= 0 { has_net = 1 }
    if string.index_of(content, "import std.net")  >= 0 { has_net = 1 }
    if string.index_of(content, "import std.fs")   >= 0 { has_fs  = 1 }
    if string.index_of(content, "import std.os")   >= 0 { has_os  = 1 }
    out = ""
    if has_net == 1 { out = "net" }
    if has_fs == 1 {
        if string.length(out) > 0 { out = string.concat(out, ",") }
        out = string.concat(out, "fs")
    }
    if has_os == 1 {
        if string.length(out) > 0 { out = string.concat(out, ",") }
        out = string.concat(out, "os")
    }
    return out
}

// _union_caps(a, b) — merge two comma-separated capability lists into one
// with no duplicates, order net,fs,os (matching _detect_caps_from_content).
// Used to floor a regen'd module's auto-detected caps with the node's
// declared entry caps: `--emit=lib` cap-gates over the TRANSITIVE import
// closure (aetherc follows imports), so a module that itself imports only
// std.file but imports a sibling using std.os still needs --with=os. The
// node already declared the closure's caps on the entry; apply them as a
// floor so the regen doesn't fail the gate. Pure. Tested in test_aether_cmd.ae.
_union_caps(a: string, b: string) {
    both = a
    if string.length(b) > 0 {
        if string.length(both) > 0 { both = string.concat(both, ",") }
        both = string.concat(both, b)
    }
    has_net = 0
    has_fs = 0
    has_os = 0
    if string.index_of(both, "net") >= 0 { has_net = 1 }
    if string.index_of(both, "fs")  >= 0 { has_fs  = 1 }
    if string.index_of(both, "os")  >= 0 { has_os  = 1 }
    out = ""
    if has_net == 1 { out = "net" }
    if has_fs == 1 {
        if string.length(out) > 0 { out = string.concat(out, ",") }
        out = string.concat(out, "fs")
    }
    if has_os == 1 {
        if string.length(out) > 0 { out = string.concat(out, ",") }
        out = string.concat(out, "os")
    }
    return out
}

// Expand the regen list with every project-local sibling module the
// graph imports transitively. Without this, every consumer has to
// enumerate `regen_with("../util/module.ae", ...)` for each
// transitive sibling by hand; forget one and the build dies with a
// `undefined reference` gcc link error and no breadcrumb back to
// "you missed a regen line" (transitive-regen-expansion.md).
//
// Strategy mirrors `_cache_key_for_aether_link`'s import scan, but
// here the closure feeds the regen list (so `_generated.c` actually
// gets built and linked) rather than the cache-key hash. BFS seeds:
// the entry .ae plus every already-declared regen entry. Each
// project-local import found gets appended with caps auto-detected
// from its own `import std.X` lines (same heuristic as plain
// `regen(...)`).
//
// Skipped:
//   - std.* / contrib.* — resolved at link via libaether.a.
//   - Already-declared paths — explicit `regen_with(..., "caps")`
//     wins over auto-detection.
//   - Unresolvable imports — silently dropped, same as
//     `_resolve_import_ae`. A genuinely missing module surfaces
//     at the aetherc step.

// _canonical_path(p) — collapse '.' / '..' / empty segments to a
// canonical spelling, so two paths to the same file compare equal. The
// motivating bug: an explicit `regen_with("../client/module.ae")` joins
// onto source_dir as `…/avnserver/../client/module.ae`, while the
// transitive-import walk resolves the same module to the clean
// `…/client/module.ae`; a raw string dedup misses the match and re-adds
// the module with weaker auto-detected caps, which aetherc 0.190's
// emit=lib cap-gate then rejects. Pure string work, NO filesystem /
// symlink resolution — it must agree with how `_resolve_import_ae`
// builds paths (plain joins, no realpath), not with the on-disk inode.
// Index of the last '/' in s, or -1. (No std.string rindex; small scan.)
_last_slash(s: string) {
    i = string.length(s) - 1
    while i >= 0 {
        if string.equals(string.substring(s, i, i + 1), "/") == 1 { return i }
        i = i - 1
    }
    return -1
}

_canonical_path(p: string) {
    if string.length(p) == 0 { return p }
    is_abs = 0
    if _is_abs_path(p) == 1 { is_abs = 1 }
    // Walk segments by chopping `rest` with index_of/substring,
    // accumulating the canonical path into one owned string `acc`
    // (cf. _extract_undefined_refs's single-scratch-string idiom).
    acc = ""
    rest = p
    seg = ""
    sl = 0
    while string.length(rest) > 0 {
        sl = string.index_of(rest, "/")
        if sl < 0 {
            seg = string.substring(rest, 0, string.length(rest))
            rest = string.concat("", "")
        } else {
            seg = string.substring(rest, 0, sl)
            rest = string.substring(rest, sl + 1, string.length(rest))
        }
        if string.length(seg) == 0 { continue }
        if string.equals(seg, ".") == 1 { continue }
        if string.equals(seg, "..") == 1 {
            ls = _last_slash(acc)
            top = acc
            if ls >= 0 { top = string.substring(acc, ls + 1, string.length(acc)) }
            if string.length(acc) > 0 {
                if string.equals(top, "..") == 0 {
                    // pop the last segment
                    if ls < 0 { acc = string.concat("", "") }
                    else { acc = string.substring(acc, 0, ls) }
                    continue
                }
            }
            // nothing to pop: keep a leading '..' only for relative paths
            if is_abs == 0 {
                if string.length(acc) > 0 { acc = string.concat(acc, "/") }
                acc = string.concat(acc, "..")
            }
            continue
        }
        if string.length(acc) > 0 { acc = string.concat(acc, "/") }
        acc = string.concat(acc, seg)
    }
    out = acc
    if is_abs == 1 { out = string.concat("/", acc) }
    if string.length(out) == 0 {
        if is_abs == 1 { return string.concat("/", "") }
        return string.concat(".", "")
    }
    return out
}

_expand_transitive_regens(builder_map: ptr, source_dir: string, src_path: string) {
    if builder_map == null { return 0 }

    // Ensure regen/regen_caps exist — a target that uses only
    // extra_source/link_flag still benefits from the expansion
    // (transitively-imported siblings of the entry need building).
    if map.has(builder_map, "regen") == 0 {
        _er1 = map.put(builder_map, "regen", list.new())
        _er2 = map.put(builder_map, "regen_caps", list.new())
    }
    regens, _ = map.get(builder_map, "regen")
    regen_caps, _ = map.get(builder_map, "regen_caps")

    roots = _ancestor_dirs(source_dir)

    // Resolve existing regen entries to absolute paths for dedup.
    known = map.new()
    n = list.size(regens)
    i = 0
    while i < n {
        rel, _ = list.get(regens, i)
        abs_p = rel
        if string.length(rel) > 0 {
            _absq = _is_abs_path(rel)
            if _absq == 0 {
                abs_p = path.join(source_dir, rel)
            }
        }
        _km = map.put(known, _canonical_path(abs_p), "1")
        i = i + 1
    }

    // BFS over (src_path + each regen entry). `_transitive_import_aes`
    // already dedups within one walk; we merge across seeds via the
    // `discovered` map.
    discovered = list.new()
    seen_disc = map.new()

    seeds = list.new()
    if string.length(src_path) > 0 {
        list.add(seeds, src_path)
    }
    j = 0
    while j < n {
        relx, _ = list.get(regens, j)
        abs_x = relx
        if string.length(relx) > 0 {
            _absq = _is_abs_path(relx)
            if _absq == 0 {
                abs_x = path.join(source_dir, relx)
            }
        }
        list.add(seeds, abs_x)
        j = j + 1
    }

    ns = list.size(seeds)
    si = 0
    while si < ns {
        seed_path, _ = list.get(seeds, si)
        imps = _transitive_import_aes(seed_path, roots)
        ni = list.size(imps)
        ii = 0
        while ii < ni {
            f, _ = list.get(imps, ii)
            if map.has(seen_disc, f) == 0 {
                _smx = map.put(seen_disc, f, "1")
                list.add(discovered, f)
            }
            ii = ii + 1
        }
        si = si + 1
    }

    // The node's declared caps, floored into each discovered module's
    // auto-detected caps: aetherc's --emit=lib gate follows the WHOLE import
    // closure, so a module importing a sibling that needs a cap it doesn't
    // import directly (e.g. webdriver.ae -> driver.ae's std.os) must still be
    // regen'd with that cap. Detecting only the file's own `import std.X`
    // under-declares; the node already named the closure's caps.
    node_caps = ""
    if map.has(builder_map, "csrc_caps") == 1 {
        node_caps, _ = map.get(builder_map, "csrc_caps")
    }

    // Append previously-unknown sibling modules to the regen list.
    // Caps auto-detected from each file's own `import std.X` lines, then
    // floored with the node's declared caps (see above).
    nd = list.size(discovered)
    di = 0
    while di < nd {
        f2, _ = list.get(discovered, di)
        cf2 = _canonical_path(f2)
        if map.has(known, cf2) == 0 {
            caps = _union_caps(_detect_caps(f2), node_caps)
            list.add(regens, f2)
            list.add(regen_caps, caps)
            _kma = map.put(known, cf2, "1")
        }
        di = di + 1
    }
    return 0
}

// Walk the regen list, run `aetherc --emit=lib X.ae X_generated.c`
// for each entry whose paired .c is missing or older than the .ae,
// and append the generated .c paths to extra_source so the gcc step
// links them in. Paths in regen(...) are resolved against source_dir.
//
// Hard-fails the build on the first aetherc error — surfaces aetherc
// stderr to the user (no 2>/dev/null suppression) so codegen errors
// are visible.
_run_regen_pass(builder_map: ptr, source_dir: string, target_dir: string, aetherc: string, mod_dir: string) {
    if builder_map == null { return 0 }
    if map.has(builder_map, "regen") == 0 { return 0 }
    regens, _ = map.get(builder_map, "regen")
    regen_caps, _ = map.get(builder_map, "regen_caps")
    n = list.size(regens)
    if n == 0 { return 0 }

    // Generated C lands under <target_dir>/regen/ (Gap 2) — never beside
    // the committed .ae source. mkdir it once.
    regen_out = path.join(target_dir, "regen")
    bldr._mkdirs(regen_out)

    // Ensure extra_source list exists so we can append generated paths.
    if map.has(builder_map, "extra_source") == 0 {
        _ee = map.put(builder_map, "extra_source", list.new())
    }
    extras, _ = map.get(builder_map, "extra_source")

    // The node's lib() module-search dirs, so a regen'd module's OWN
    // imports (project modules under those dirs) resolve — the entry
    // compile already gets these; the closure regen must too.
    node_lib_flags = _node_lib_flags(builder_map, source_dir)

    // The node's declared caps (caps("net,os,fs")), floored into each
    // auto-detected regen so a module that transitively imports a sibling
    // needing a cap it doesn't itself import still passes aetherc's
    // --emit=lib gate (which follows the whole import closure).
    node_caps = ""
    if map.has(builder_map, "csrc_caps") == 1 {
        node_caps, _ = map.get(builder_map, "csrc_caps")
    }

    i = 0
    while i < n {
        rel, _ = list.get(regens, i)
        explicit_caps, _ = list.get(regen_caps, i)
        // Pass absolute paths through verbatim — `path.join` is naive
        // and would double-up the prefix (`source_dir//abs/...`). The
        // transitive-import expansion seeds absolute paths into the
        // regen list, so this branch is the common case once the
        // expansion pass has run.
        ae_abs = rel
        if string.length(rel) > 0 {
            _absq = _is_abs_path(rel)
            if _absq == 0 {
                ae_abs = path.join(source_dir, rel)
            }
        }
        // Validate the entry is an .ae, but emit the generated C
        // out-of-tree under target/ rather than beside the source.
        if string.length(_paired_generated_c(rel)) == 0 {
            println("${mod_dir}: regen entry must end in .ae: ${rel}")
            return 1
        }
        c_abs = _regen_target_c(target_dir, ae_abs)
        c_rel = path.basename(c_abs)

        ae_mtime = file.mtime(ae_abs)
        if ae_mtime == 0 {
            println("${mod_dir}: regen source not found: ${ae_abs}")
            return 1
        }
        c_mtime = file.mtime(c_abs)
        action = _regen_action(ae_mtime, c_mtime)
        // A toolchain rebuilt between release tags leaves the .ae
        // mtime untouched, so _regen_action would skip — but the
        // generated .c is stale codegen from the old compiler.
        // Regenerate when aetherc is newer than the .c (mtime, to
        // match regen's existing mtime-skip model; `make install`
        // bumps the binary's mtime).
        if string.equals(action, "skip") == 1 {
            tc_mtime = file.mtime(aetherc)
            if c_mtime < tc_mtime {
                action = "toolchain"
            }
        }
        if string.equals(action, "missing") == 1 {
            println("${mod_dir}: regen ${rel} → ${c_rel} (missing)")
        }
        if string.equals(action, "stale") == 1 {
            println("${mod_dir}: regen ${rel} → ${c_rel} (stale)")
        }
        if string.equals(action, "toolchain") == 1 {
            println("${mod_dir}: regen ${rel} → ${c_rel} (toolchain newer)")
        }
        needs_regen = 0
        if string.equals(action, "skip") == 0 { needs_regen = 1 }

        if needs_regen == 1 {
            // Capability resolution: explicit regen_with(...) caps win.
            // Otherwise scan the .ae for `import std.<X>` and infer, then
            // floor with the node's declared caps (the module's transitive
            // closure may need caps it doesn't import directly).
            caps = explicit_caps
            if string.length(caps) == 0 {
                caps = _union_caps(_detect_caps(ae_abs), node_caps)
            }
            cmd = aetherc_emit_lib_cmd(aetherc, ae_abs, c_abs, caps, node_lib_flags)
            rc = bldr._sh(cmd)
            if rc != 0 {
                println("${mod_dir}: aetherc --emit=lib failed for ${rel}")
                return rc
            }
        }
        _e1 = list.add(extras, c_abs)
        i = i + 1
    }
    return 0
}

// --- Option B: extern link-failure diagnostic ----------------------
//
// `_expand_transitive_regens` walks `import` lines but cannot follow
// `extern <sym>(...)` declarations into a sibling module's symbols.
// When that gap manifests, gcc fails with `undefined reference to
// <sym>` and the porter has to guess which sibling defines the
// symbol. The helpers below mine gcc's stderr after a link failure,
// match each undefined symbol against `module_generated.c` files in
// the workspace, and print a `hint:` line naming the missing
// regen_with declaration. See asks/transitive-regen-extern-followup.md.

// Pure helper — parse gcc stderr for "undefined reference to `<sym>'"
// occurrences. Returns the symbols in first-occurrence order, with
// duplicates collapsed.
//
// Loop shape mirrors `_transitive_import_aes`: a single scratch string
// (`rest`) is chopped down via successive `string.substring(rest, ...)`
// reassignments. Don't introduce an intermediate `after` variable
// derived from `rest` and then reassign back to rest from `after` —
// that combination silently drops the substring payload in aetherc's
// current heap-string codegen, returning empty strings. The
// test_aether_extern_diagnostics regression pins the working shape.
_extract_undefined_refs(stderr_text: string) {
    syms = list.new()
    seen = map.new()
    if string.length(stderr_text) == 0 { return syms }
    needle = "undefined reference to `"
    rest = ""
    sym = ""
    idx = 0
    end = 0
    rest = stderr_text
    while string.length(rest) > 0 {
        idx = string.index_of(rest, needle)
        if idx < 0 { return syms }
        // Step 1: drop everything up to and including the needle.
        rest = string.substring(rest, idx + string.length(needle), string.length(rest))
        // Step 2: find the closing apostrophe in what's left.
        end = string.index_of(rest, "'")
        if end < 0 { return syms }
        // Step 3: symbol is [0, end). Add if new.
        sym = string.substring(rest, 0, end)
        if string.length(sym) > 0 {
            if map.has(seen, sym) == 0 {
                _seenp = map.put(seen, sym, "1")
                _addp = list.add(syms, sym)
            }
        }
        // Step 4: drop the symbol + its closing apostrophe.
        rest = string.substring(rest, end + 1, string.length(rest))
    }
    return syms
}

// Locate the sibling Aether module that defines `sym` by searching
// every module_generated.c under project_root for the function-like
// pattern `<sym>(`. Returns the .ae path of the defining module
// (typically <root>/<sibling>/module.ae) or "" when no match. Best-
// effort: shells out to grep, short-circuits on first hit.
_find_extern_definer(project_root: string, sym: string) {
    if string.length(project_root) == 0 { return "" }
    if string.length(sym) == 0 { return "" }
    pattern = string.concat(sym, "(")
    cmd = "grep -rl --include='module_generated.c' -F -- '${pattern}' '${project_root}' 2>/dev/null | head -1"
    out, _err = bldr._sh_capture(cmd)
    found_c = string.trim(out)
    if string.length(found_c) == 0 { return "" }
    mod_dir = path.dirname(found_c)
    module_ae = path.join(mod_dir, "module.ae")
    if file.exists(module_ae) == 1 { return module_ae }
    return ""
}

// Compute the path from `from_dir` to `to_file` suitable for a
// `regen_with(...)` first argument. Shells out to python3 (already
// an aeb dependency for lib/dotnet / lib/python). Returns "" on any
// failure; the caller can fall back to the absolute path.
_relpath_for_hint(from_dir: string, to_file: string) {
    cmd = "python3 -c \"import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))\" '${to_file}' '${from_dir}' 2>/dev/null"
    out, _err = bldr._sh_capture(cmd)
    return string.trim(out)
}

// Top-level: parse stderr, group missing symbols by defining sibling,
// print one hint line per sibling with the suggested `regen_with(...)`.
// No-op when no undefined symbols resolve to a project module — true
// C externs (libc, runtime libs) skip silently.
_emit_extern_hints(ctx: ptr, source_dir: string, stderr_text: string) {
    syms = _extract_undefined_refs(stderr_text)
    n = list.size(syms)
    if n == 0 { return 0 }
    root = bldr._get(ctx, "root")
    if string.length(root) == 0 { return 0 }

    by_module = map.new()
    order = list.new()
    i = 0
    sym = ""
    definer = ""
    sl = list.new()
    while i < n {
        sym, _ = list.get(syms, i)
        definer = _find_extern_definer(root, sym)
        if string.length(definer) > 0 {
            if map.has(by_module, definer) == 0 {
                _bm1 = map.put(by_module, definer, list.new())
                _ord = list.add(order, definer)
            }
            sl, _ = map.get(by_module, definer)
            _bm2 = list.add(sl, sym)
        }
        i = i + 1
    }

    nm = list.size(order)
    if nm == 0 { return 0 }
    println("")
    println("aeb: undefined symbol(s) appear to be defined by sibling Aether module(s).")
    println("aeb: this usually means the consumer reaches the sibling via `extern` rather")
    println("aeb: than `import`, so transitive-regen expansion missed it. Suggested fix —")
    println("aeb: add to the .build.ae:")
    mi = 0
    mod_ae = ""
    ns = 0
    rel = ""
    // node_caps, NOT caps: `caps` is a top-level setter in lib/aether, and a
    // same-name local binds `${caps}` to the FUNCTION POINTER (an x86 prologue),
    // not the string. Same footgun as lib/lua's run_cmd. See
    // asks/lua-conformance-executes-machine-code-as-a-shell-command.md.
    node_caps = ""
    sym_list = ""
    j = 0
    sj = ""
    while mi < nm {
        mod_ae, _ = list.get(order, mi)
        sl, _ = map.get(by_module, mod_ae)
        ns = list.size(sl)
        rel = _relpath_for_hint(source_dir, mod_ae)
        node_caps = _detect_caps(mod_ae)
        sym_list = ""
        j = 0
        while j < ns {
            sj, _ = list.get(sl, j)
            if j > 0 { sym_list = string.concat(sym_list, ", ") }
            sym_list = string.concat(sym_list, sj)
            j = j + 1
        }
        if string.length(rel) > 0 {
            println("  regen_with(\"${rel}\", \"${node_caps}\")  // defines ${sym_list}")
        } else {
            println("  regen_with(\"${mod_ae}\", \"${node_caps}\")  // defines ${sym_list}")
        }
        mi = mi + 1
    }
    return 0
}

// Manual build path: aetherc + gcc, with optional extra_source,
// link_flag, and regen entries from the builder block. Used when the
// .build.ae declares any of those — bypasses aether.toml entirely so
// the .build.ae is the single source of truth.
_compile_and_link(ctx: ptr, builder_map: ptr, src_path: string, bin_path: string, c_path: string) {
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")

    ae_dir = _resolve_aether_dir()
    // .exe on Windows: the file on disk is aetherc.exe, and every OTHER site
    // that names a tool binary already suffixes (tools/aeb-link.ae's `esuf`,
    // and the bin_path composition further down this same file). This one did
    // not, so the composed command named a file that does not exist.
    // (asks/windows-fanout-aetherc-invoked-as-directory.md)
    aetherc = path.join(ae_dir, string.concat("aetherc", bldr._exe_suffix()))

    // Phase 0a: expand regen entries to cover every transitive
    // project-local sibling import. Without this the consumer has to
    // enumerate every `regen_with("../util/module.ae", ...)` by hand
    // (transitive-regen-expansion.md).
    //
    // Suppressed by no_closure_regen() — the "thin Aether over a C
    // backend" shape, where imports are extern declarations of a C ABI
    // and can't be `--emit=lib`'d standalone. The closure still feeds
    // the cache key below (hashed independently in
    // _cache_key_for_aether_link), so staleness tracking is unaffected.
    // See asks/thin-aether-over-c-backend.md.
    skip_closure_regen = 0
    if builder_map != null {
        if map.has(builder_map, "no_closure_regen") == 1 { skip_closure_regen = 1 }
    }
    if skip_closure_regen == 0 {
        _expand_transitive_regens(builder_map, source_dir, src_path)
    }

    // Phase 0b: regen .ae → _generated.c (under target/, not beside the
    // source) for each entry (declared + discovered).
    rrc = _run_regen_pass(builder_map, source_dir, target_dir, aetherc, mod_dir)
    if rrc != 0 {
        return rrc
    }

    // Resolve toolchain-dependent inputs early so the cache key can
    // hash them before we run aetherc + gcc. Same values are also
    // used by phase 2's link below, so this is also just a small
    // hoist of work that would happen anyway.
    lib_dir = _resolve_libaether_dir(ae_dir)
    if string.length(lib_dir) == 0 {
        println("${mod_dir}: libaether.a not found near ${ae_dir} — your Aether install looks incomplete")
        bldr.fail(ctx, "libaether.a not found")
        return 1
    }
    dup_flag = bldr._dup_symbol_link_flag()
    shared_libs = _collect_shared_libs(ctx)

    // Resolve extra `-I` include dirs (user include_dir + dep
    // c_header_dirs) BEFORE the cache key, and stash them on the builder
    // so _cache_key_for_aether_link can hash them (and the headers in
    // them) without a signature change. Built into the gcc -I block at
    // link time below.
    extra_inc_dirs = _all_extra_include_dirs(ctx, builder_map, source_dir)
    if builder_map != null {
        _eid = map.put(builder_map, "_resolved_inc_dirs", extra_inc_dirs)
    }

    // Expand extra_source_glob(...) patterns into the extra_source
    // list BEFORE the cache key is computed, so the key correctly
    // hashes globbed-in files. Idempotent — runs once per builder
    // invocation.
    _expand_source_globs(builder_map, source_dir)

    // Cache check: if the same (sources, flags, deps, toolchain)
    // already produced a binary, restore from the content-addressed
    // cache and skip aetherc + gcc entirely. Best-effort: any error
    // computing the key (unreadable input file, hashing failure)
    // falls through to the live build path.
    //
    // The outcome recorded here is PROVISIONAL — see the `_record_cache`
    // call after the link below. A marker written on the way IN says only
    // "the cache did not answer"; it cannot say the build happened,
    // because the build has not run yet. `[miss]` has to mean "rebuilt",
    // so the authoritative write is the one at the end.
    // (asks/fanout-reports-miss-but-skips-rebuild.md)
    // AEB_NO_CACHE escape hatch. An operator who KNOWS the environment
    // changed underneath a content-addressed key aeb couldn't see (a
    // /usr/local library swapped at the same path — the exact hole this
    // cache-key work closes, but also any future one) forces a fresh
    // build without `rm -rf`ing the whole CAS, which would evict every
    // unrelated good entry too. We skip only the READ: the key is still
    // computed and the result still WRITTEN below, so this rebuild
    // repopulates the entry correctly rather than leaving a gap.
    // Any non-empty value enables it (AEB_NO_CACHE=1 is the documented
    // spelling). (asks/cache-key-omits-external-include-and-lib-contents.md)
    no_cache = string.length(os.getenv("AEB_NO_CACHE")) > 0

    cache_key = ""
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_aether_link(builder_map, source_dir, src_path, lib_dir, dup_flag, shared_libs)
        if string.length(kerr) == 0 {
            cache_key = ck
            // mkdir parent so cache.get's atomic write has somewhere to land.
            bin_parent = path.dirname(bin_path)
            bldr._mkdirs(bin_parent)
            grc = "miss"
            if no_cache == 0 {
                grc = cache.get(cache_key, bin_path)
            }
            if string.length(grc) == 0 {
                bldr._sh("chmod +x ${bin_path}")
                println("${mod_dir}: aether cache hit ${cache_key}")
                bldr._record_cache(ctx, "hit")
                return 0
            }
            // grc != "" means miss or transport error — fall through.
        } else {
            // A key we could not compute is NOT a cache miss — it means an
            // input could not be hashed (unreadable file, vanished mid-scan,
            // sandbox denial). Silently treating it as a miss is what made an
            // intermittent hashing failure undiagnosable across a 79-target
            // parallel fan-out: the row rendered exactly like a normal
            // rebuild. Say it, name the reason, and record a DISTINCT outcome
            // so the telemetry cannot spell it `[miss]`.
            //
            // aether >= 0.506.0 makes `kerr` worth printing: it names the
            // path and the cause ("/x/y.ae: Permission denied") instead of a
            // bare "cannot read file". NB the message is borrowed from
            // thread-local storage and is only valid until this thread's next
            // failed read — so it is formatted into the line HERE, never
            // stashed for later.
            println("${mod_dir}: cache key not computable (${kerr}) — building without cache")
            bldr._record_cache(ctx, "key-error")
        }
    }
    if cache.available() == 0 {
        bldr._record_cache(ctx, "unavailable")
    }

    // Phase 1: aetherc src.ae → src.c
    //
    // Thread the orchestrator's search path (AEB_COMPILE_LIB, set by
    // tools/aeb-link as <aeb_lib>:<repo_root>) onto this standalone
    // compile so the entry's `import`s resolve. Without it, an entry
    // importing an extern-backed sibling module (the no_closure_regen
    // thin-Aether-over-C shape) fails here with E0301 — the import
    // resolves to nothing because aetherc only searches cwd + --lib,
    // and the entry's siblings live under the repo root, not cwd.
    // Absent the env var (e.g. a direct lib/aether unit invocation),
    // fall back to no --lib, preserving prior behaviour for the
    // self-contained-entry case.
    // ONE `--lib` FLAG PER ENTRY — never the separator-joined value verbatim.
    //
    // AEB_COMPILE_LIB is PATH-style (`<aeb_lib><sep><repo_root>`), and the
    // separator is `;` on Windows. Splicing that straight onto a command line
    // hands `sh` a statement separator, so the single command
    //
    //     aetherc --lib C:/…/lib;C:/…/aether-ui src.ae out.c
    //
    // ran as TWO: `aetherc --lib C:/…/lib` (too few positional args, so it
    // printed its usage text and exited non-zero) followed by
    // `C:/…/aether-ui src.ae out.c` (the repo root in command position —
    // "Is a directory"). Both halves of that symptom came from this one
    // splice. tools/aeb-link.ae already emits repeated flags for exactly this
    // reason and says so where it builds the value; this consumer did not
    // honour it. Same fix, same rationale: aetherc's first `--lib` resets the
    // chain and each subsequent one appends, so repeated flags compose into
    // the identical search path with no shell-quoting fragility.
    // (asks/windows-fanout-aetherc-invoked-as-directory.md)
    // _ae_build_lib_flags is the existing splitter (the `ae build` shell-out
    // path was hardened against this same trap; this consumer was missed).
    lib_flag = _ae_build_lib_flags(os.getenv("AEB_COMPILE_LIB"))
    // Per-node lib() dirs, appended AFTER the env path so a node only ADDS to
    // the orchestrator's search path. Lets an app import sibling modules from a
    // repo subdir other than its source dir / root (e.g. aevg/apps/* importing
    // vg/* from aevg/). See asks/aether-program-per-node-lib-search-path.md.
    lib_flag = string.concat(lib_flag, _node_lib_flags(builder_map, source_dir))
    ac_cmd = "${aetherc}${lib_flag} ${src_path} ${c_path}"
    rc = bldr._sh(ac_cmd)
    if rc != 0 {
        println("${mod_dir}: aetherc failed")
        bldr.fail(ctx, "aetherc failed")
        return rc
    }

    // Phase 2: gcc src.c (+ extra_source) + runtime → bin, plus any
    // shared library deps and user-supplied link_flag.
    extra_link = ""
    rpath_link = ""
    if string.length(shared_libs) > 0 {
        extra_cmd = "echo '${shared_libs}' | tr '\n' ' '"
        el_raw, _e1 = bldr._sh_capture(extra_cmd)
        extra_link = string.trim(el_raw)
        rpath_cmd = "echo '${shared_libs}' | xargs -n1 dirname 2>/dev/null | sort -u | sed 's|^|-Wl,-rpath,|' | tr '\n' ' '"
        rp_raw, _e2 = bldr._sh_capture(rpath_cmd)
        rpath_link = string.trim(rp_raw)
    }

    // Concatenate user-declared extra_source (if any). Relative
    // entries are resolved against source_dir for parity with
    // regen(...) — both setters now treat their string args as
    // module-relative. Absolute paths (anything starting with /)
    // are passed through verbatim, which is also how
    // _run_regen_pass already pushes its absolute generated.c
    // entries into this same list.
    // (extra_source_glob expansion already happened pre-cache-key
    // via _expand_source_globs; the loop below sees a flat
    // extra_source list with glob results merged in.)

    extras_str = ""
    if builder_map != null {
        if map.has(builder_map, "extra_source") == 1 {
            extras, _ = map.get(builder_map, "extra_source")
            ne = list.size(extras)
            ie = 0
            while ie < ne {
                ef, _ = list.get(extras, ie)
                resolved = ef
                if string.length(ef) > 0 {
                    _absq = _is_abs_path(ef)
                    if _absq == 0 {
                        resolved = path.join(source_dir, ef)
                    }
                }
                extras_str = string.concat(extras_str, " ")
                extras_str = string.concat(extras_str, resolved)
                ie = ie + 1
            }
        }
    }

    // Concatenate user-declared link_flag (if any).
    user_flags = ""
    if builder_map != null {
        if map.has(builder_map, "link_flag") == 1 {
            flags, _ = map.get(builder_map, "link_flag")
            nf = list.size(flags)
            jf = 0
            while jf < nf {
                ff, _ = list.get(flags, jf)
                user_flags = string.concat(user_flags, " ")
                user_flags = string.concat(user_flags, ff)
                jf = jf + 1
            }
        }
    }

    // -I: real installs nest headers under include/aether/{runtime,std}/...
    // Generated C uses bare #include names, so add -I for every dir.
    // (lib_dir + dup_flag were resolved above for the cache-key step.)
    // RESOLVED HERE, for the same reason as sysdeps above: `$(find … | sed
    // 's|^|-I|')` is command substitution AND single quotes on one line, which
    // cmd.exe cannot perform and would mangle. Run it through the chokepoint
    // now and splice the literal -I run.
    // (asks/windows-pkg-config-substitution-runs-in-cmd.md)
    // HEADER-BEARING DIRS ONLY, not every dir under the root. When inc_root is
    // a dev checkout (see bldr._resolve_aether_include) a bare `-type d` sweep
    // pulls in .git/, asks/, benchmarks/ and hundreds more that hold no .h —
    // which is how the link line once measured 39 KB / 621 args and blew
    // Windows' ~32 KB CreateProcess ceiling
    // (asks/windows-gcc-argument-list-too-long.md). Find the headers, strip to
    // their parent dirs, dedup. Same shape aeb-link already uses.
    inc_root = _resolve_aether_include(ae_dir)
    inc_flags = ""
    if string.length(inc_root) > 0 {
        find_inc = "find ${inc_root} -type d -name .git -prune -o -type d -name build -prune -o -name *.h -print | sed -e s,/[^/]*$,, -e s,^,-I, | sort -u"
        inc_raw, _ierr = bldr._sh_capture(find_inc)
        inc_flags = _flags_from_lines(inc_raw)
    }
    // Plus the user/dep extra include dirs (Gap 1) — so an extra_source
    // wrapper .c that #includes a project or generated-table header
    // resolves. Resolved once above and stashed on the builder.
    inc_flags = string.concat(inc_flags, _inc_flags_from_dirs(extra_inc_dirs))

    coverage = ""
    if string.length(os.getenv("AEB_COVERAGE")) > 0 {
        coverage = "1"
    }

    opts = map.new()
    _eo1 = map.put(opts, "c_path", c_path)
    _eo2 = map.put(opts, "bin_path", bin_path)
    _eo3 = map.put(opts, "lib_dir", lib_dir)
    _eo4 = map.put(opts, "inc_flags", inc_flags)
    _eo5 = map.put(opts, "extras_str", extras_str)
    _eo6 = map.put(opts, "extra_link", extra_link)
    _eo7 = map.put(opts, "rpath_link", rpath_link)
    _eo8 = map.put(opts, "user_flags", user_flags)
    _eo9 = map.put(opts, "dup_flag", dup_flag)
    _eo10 = map.put(opts, "coverage", coverage)
    // Resolve pkg-config HERE (one shell-out per module, through the
    // chokepoint) and hand aether_link_cmd literal flags. Keeps that builder
    // pure/testable and keeps `$(...)` off a command line whose shell we do
    // not control. (asks/windows-pkg-config-substitution-runs-in-cmd.md)
    _eo11 = map.put(opts, "sysdeps", _resolve_sysdeps())
    // Module-declared native deps from `@link`, read back from the generated
    // C's `// aether-link:` header (aether #1549/#1555). `-D`-sensitive and
    // transitive — a dropped `when defined` import drops its libs. aeb's manual
    // gcc path bypasses `ae build`, so it reads the header itself here; the
    // ae-build shell-out path gets this from the toolchain (>=0.532.0). Plus the
    // dev-layout <lib_dir>/contrib on -L so a contrib veneer archive resolves.
    _eo12 = map.put(opts, "aether_link", bldr._aether_link_libs(c_path))
    _eo13 = map.put(opts, "contrib_L", bldr._contrib_lib_dir_flag(lib_dir))
    gcc_cmd = aether_link_cmd(opts)
    // Capture gcc stderr to a per-module file so a link failure can
    // be mined for `undefined reference` symbols (Option B in
    // asks/transitive-regen-extern-followup.md). The user still sees
    // gcc's output — we replay it on the failure path before the
    // hint lines.
    target_dir = bldr._get(ctx, "target_dir")
    gcc_stderr_path = path.join(target_dir, "_gcc_stderr.log")
    gcc_with_capture = string.concat(gcc_cmd, " 2>")
    gcc_with_capture = string.concat(gcc_with_capture, gcc_stderr_path)
    rc = bldr._sh(gcc_with_capture)
    if rc != 0 {
        bldr._sh("cat ${gcc_stderr_path} >&2 2>/dev/null")
        // Name the log. The replay above goes to stderr, so anyone who
        // redirected it (or scrolled past a multi-node build) needs the
        // path to go back to — issue #13 asked for exactly this.
        println("${mod_dir}: gcc link failed (see ${gcc_stderr_path})")
        stderr_text, _serr = io.read_file(gcc_stderr_path)
        if string.length(stderr_text) > 0 {
            _emit_extern_hints(ctx, source_dir, stderr_text)
        }
        bldr.fail(ctx, "gcc link failed")
        return rc
    }

    // Populate the cache so future builds with the same inputs
    // short-circuit at the cache-check step above. Best-effort:
    // a write failure is logged but doesn't fail the build.
    if string.length(cache_key) > 0 {
        perr = cache.put(cache_key, bin_path)
        if string.length(perr) > 0 {
            println("${mod_dir}: aether cache write failed: ${perr}")
        }
    }

    // AUTHORITATIVE cache outcome. Reached only after aetherc AND gcc both
    // succeeded, so `[miss]` here means what a reader assumes it means: this
    // node was rebuilt. Recording it on the way in (where the cache declined)
    // let a node that then did no work render the exact row a real rebuild
    // renders — 79 lines of `[miss]` read as a full rebuild while eight
    // binaries had not moved.
    //
    // Deliberately does NOT overwrite "key-error": that outcome describes the
    // cache decision (an input could not be hashed), which stays true even
    // though the build went on to succeed. It renders distinctly so the row
    // cannot be mistaken for a clean rebuild, and it is the breadcrumb back to
    // the unhashable input.
    if string.equals(bldr._read_cache_outcome(bldr._get(ctx, "target_dir")), "key-error") == 0 {
        bldr._record_cache(ctx, "miss")
    }
    return 0
}

// Router: shell out to `ae build` by default; take the manual path
// when the user declared extra_source(...) / link_flag(...) / regen(...)
// OR when the module has shared-library deps (a `bldr.dep` on a
// crate/lib that produced a `shared_library_deps_including_transitive`
// artifact — e.g. a Rust cdylib the Aether program FFIs into). `ae
// build` knows nothing about those .so files, so the default
// shell-out would leave the extern symbols unresolved at link
// (undefined reference to Aether_..._printString). The manual gcc
// path collects the .so paths via _collect_shared_libs and links
// them with -L/-l + -Wl,-rpath. c_path is only consumed by the
// manual path (the intermediate .c aetherc emits).
_build_binary(ctx: ptr, builder_map: ptr, src_path: string, bin_path: string, c_path: string) {
    // Cross-compile (target()) forces the `ae build` shell-out: only ae's
    // bundled zig-cc/emcc backend can target a foreign triple. The manual
    // local-gcc path (_compile_and_link) links for the host only, so a
    // target() that ALSO carried manual overrides would silently produce a
    // host binary. Reject that combination up front rather than mislead.
    tgt = _node_target(builder_map)
    if string.length(tgt) > 0 {
        if _has_manual_overrides(builder_map) == 1 {
            bldr.fail(ctx, "aether.program: target() cross-compiles via `ae build` and cannot be combined with extra_source/link_flag/include_dir/regen (host-only manual link) — use aether.csrc + a c.program cross build for hand-linked C")
            return 1
        }
        if string.length(_collect_shared_libs(ctx)) > 0 {
            bldr.fail(ctx, "aether.program: target() cross-compiles via `ae build` and cannot consume cross-language shared-lib deps (they are host artifacts)")
            return 1
        }
        return _shell_out_ae_build(ctx, builder_map, src_path, bin_path, "")
    }
    if _has_manual_overrides(builder_map) == 1 {
        return _compile_and_link(ctx, builder_map, src_path, bin_path, c_path)
    }
    if string.length(_collect_shared_libs(ctx)) > 0 {
        return _compile_and_link(ctx, builder_map, src_path, bin_path, c_path)
    }
    return _shell_out_ae_build(ctx, builder_map, src_path, bin_path, "")
}

// _node_target(builder_map) — the declared cross triple, or "" for a
// host build. Pure map read.
_node_target(builder_map: ptr) {
    if builder_map == null { return "" }
    if map.has(builder_map, "target") == 0 { return "" }
    t, _ = map.get(builder_map, "target")
    return t
}

// _target_flag(builder_map) — the " --target=<triple>" fragment for the
// `ae build` command (leading space, spliced after "build"), or "" for a
// host build. Pure.
_target_flag(builder_map: ptr) {
    t = _node_target(builder_map)
    if string.length(t) == 0 { return "" }
    return string.concat(" --target=", t)
}

// _program_out_suffix(builder_map) — output-file extension for the built
// binary. Host build → _exe_suffix() (".exe" on Windows, else ""). A
// cross target() overrides that with the TARGET's convention, not the
// host's: any wasm triple → ".wasm" (both `wasm` emcc — which also emits a
// sidecar .js — and `wasm32-wasi`), a cross *-windows triple → ".exe".
// Everything else (linux/macos/freebsd cross) → "" like the host default.
// Pure string work.
_program_out_suffix(builder_map: ptr) {
    t = _node_target(builder_map)
    if string.length(t) == 0 { return bldr._exe_suffix() }
    if string.index_of(t, "wasm") >= 0 { return ".wasm" }
    if string.index_of(t, "windows") >= 0 { return ".exe" }
    return ""
}

_default_source_name(ctx: ptr) {
    // Default source file name = last path component of module dir + ".ae"
    mod_dir = bldr._get(ctx, "module_dir")
    cmd = "basename '${mod_dir}'"
    base_raw, _eerr = bldr._sh_capture(cmd)
    base = string.trim(base_raw)
    return string.concat(base, ".ae")
}

// --- SDK builders ---

// aether.tinygo_lib(b) — compile a user's .go to a c-shared .so for
// contrib.host.tinygo.
//
// The sidecar shape (docs/design/host-tinygo-sidecar.md): unlike the six interpreter
// bridges (python/ruby/…), contrib.host.tinygo has no system lib — the user's
// Go is compiled to a .so that an Aether program tinygo.load()s by path at
// runtime. So this builder produces a .so as its declared output; a downstream
// program / program_test that dep()s it loads that .so.
//
//   aether.tinygo_lib(b) {
//       go_source("greet.go")     // the .go (relative to module dir)
//       output("libgreet.so")     // sidecar name the .ae will tinygo.load()
//   }
//
// IMPORTANT — built with STANDARD `go`, not `tinygo`: TinyGo's
// `-buildmode=c-shared` is wasm-only (verified on TinyGo 0.34.0:
// "buildmode c-shared is only supported on wasm at the moment"). For a NATIVE
// host .so the standard Go toolchain is the right tool — `CGO_ENABLED=1 go
// build -buildmode=c-shared` produces a real native c-shared .so. The bridge
// is a runtime dlopen of the .so; it does not care which compiler produced it,
// only that it's a valid c-shared with the exported symbols. (The `tinygo_`
// name is kept for the module/loader; see ctr_notes — capability naming is an
// aether-side call.)
//
// Compile-only by nature (a lib has no run step): active under --compile-only,
// inert under --execute-only. Under aeb-ctr the compile happens in the
// container (the Go toolchain is present there); the .so lands on the host via
// the mount, beside the Aether binary, so Phase-2 host execution finds it. The
// AEB_COMPILE_CONTAINER per-step delegation seam is honored too (same as the
// other builders) for non-aeb-ctr hosts that delegate one step at a time.
builder tinygo_lib(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    lib_dir = path.join(target_dir, "lib")
    bldr._mkdirs(lib_dir)

    go_name = "main.go"
    if _builder != null {
        if map.has(_builder, "go_source") == 1 {
            go_name, _ = map.get(_builder, "go_source")
        }
    }
    go_path = path.join(source_dir, go_name)

    out_name = "libtinygo.so"
    if _builder != null {
        if map.has(_builder, "output") == 1 {
            out_name, _ = map.get(_builder, "output")
        }
    }
    so_path = path.join(lib_dir, out_name)

    // COMPILE phase — skipped under --execute-only (the .so was built in the
    // container pass already). The artifact-write below runs in both passes so
    // dependents can locate the .so regardless. (two-aeb duality.)
    if bldr._compile_enabled() == 1 {
        println("${mod_dir}: compiling Go c-shared lib (sidecar for contrib.host.tinygo)")

        // Per-step container delegation (AEB_COMPILE_CONTAINER): host-aeb has
        // no Go toolchain, so run the `go build` step IN the toolchain image.
        // Paths rewritten root/… → /work/… (root bind-mounted at /work). Unset
        // → plain local `go` (which is what aeb-ctr's in-container Phase 1 uses,
        // since the orchestrator itself already runs in the image). CGO_ENABLED=1
        // is required for -buildmode=c-shared with `import "C"` exports.
        container_image = os.getenv("AEB_COMPILE_CONTAINER")
        if string.length(container_image) > 0 {
            root = bldr._get(ctx, "root")
            wgo = _rewrite_under_root(go_path, root, "/work")
            wso = _rewrite_under_root(so_path, root, "/work")
            engine = os.getenv("AEB_CONTAINER_ENGINE")
            if string.length(engine) == 0 { engine = "podman" }
            selabel = os.getenv("AEB_CONTAINER_SELABEL")
            if string.length(selabel) == 0 { selabel = "Z" }
            mount = "-v ${root}:/work:${selabel}"
            cmd = "${engine} run --rm -e CGO_ENABLED=1 ${mount} -w /work --entrypoint go ${container_image} build -buildmode=c-shared -o ${wso} ${wgo}"
            rc = bldr._sh(cmd)
            if rc != 0 {
                println("${mod_dir}: go build (in ${container_image}) failed")
                bldr.fail(ctx, "go c-shared build (containerized) failed")
                return rc
            }
        } else {
            cmd = "CGO_ENABLED=1 go build -buildmode=c-shared -o ${so_path} ${go_path}"
            rc = bldr._sh(cmd)
            if rc != 0 {
                println("${mod_dir}: go build failed")
                bldr.fail(ctx, "go c-shared build failed")
                return rc
            }
        }
    }

    // Declared output: the sidecar .so path. A downstream program/program_test
    // that dep()s this node resolves it (bldr._dep_target_dir) so its .ae can
    // tinygo.load(it). Written in both passes so the host pass can locate it.
    bldr._write_artifact(ctx, "tinygo_shared_lib", so_path)
    bldr._write_artifact(ctx, "shared_library", so_path)
    return 0
}

builder program(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bin_dir = path.join(target_dir, "bin")
    bldr._mkdirs(bin_dir)

    src_name = _default_source_name(ctx)
    if _builder != null {
        if map.has(_builder, "source") == 1 {
            src_name, _ = map.get(_builder, "source")
        }
    }
    src_path = path.join(source_dir, src_name)

    out_name = "program"
    if _builder != null {
        if map.has(_builder, "output") == 1 {
            out_name, _ = map.get(_builder, "output")
        }
    }
    bin_path = path.join(bin_dir, string.concat(out_name, _program_out_suffix(_builder)))
    c_path = path.join(target_dir, string.concat(out_name, ".c"))

    // Compile phase — skipped under --execute-only (the binary was already
    // built in the container pass; the host pass only executes). The
    // artifact-writes below still run in both passes so dependents can
    // locate the binary regardless. (two-aeb duality, docs/design/two-aeb-duality.md)
    if bldr._compile_enabled() == 1 {
        println("${mod_dir}: compiling Aether program")
        rc = _build_binary(ctx, _builder, src_path, bin_path, c_path)
        if rc != 0 {
            bldr.fail(ctx, "aether program build failed")
            return rc
        }
    }

    bldr._write_artifact(ctx, "aether_binary", bin_path)
    // Universal runnable-binary contract (bldr.program_binary_of), so a
    // c.tests (or any) suite can run this binary the same way it runs a
    // c.program's — without the artifact key being SDK-specific.
    bldr._write_artifact(ctx, "program_binary", bin_path)
    return 0
}

// aether.csrc(b) — emit a distributable C-SOURCE package from an .ae
// module (aether 0.357 `ae build --emit=csrc`): <name>.c (portable
// generated C) + <name>.h (catalog header with the aether_<fn>()
// prototypes) under target/<module>/, and STOP — no gcc, no host .so.
// The consumer compiles it wherever (`cc -fPIC -shared <name>.c
// $(ae cflags)`, WASM, static link) — the compile-on-install /
// source-registry primitive (see asks/aeb-build-fetch-and-emit-lib-
// for-zsync-so.md for the demand).
//
//   aether.csrc(b) {
//       source("greet.ae")   // default: <moduledir>.ae
//       output("greet")      // default: source name minus .ae
//       caps("net")          // optional --with= csv (fs,net,os,…)
//   }
//
// Deliberately a SEPARATE builder, not an emit() mode on
// aether.program: the artifact contract differs (no program_binary —
// nothing here is runnable), and program's downstream consumers
// (c.tests via bldr.program_binary_of) must never find a
// half-populated node. Same reasoning that made tinygo_lib its own
// builder. Manual-path setters (extra_source/link_flag/regen) are not
// honoured here — csrc is always the `ae build` shell-out; a node
// needing hand-linked C extras wants aether.program or c.program.
//
// Published artifacts:
//   c_source        — target/<module>/<name>.c
//   c_header        — target/<module>/<name>.h
//   c_header_dirs   — target/<module> (a dependent c.program -I's it,
//                     same contract c.generated_header publishes)
//   c_needs_aether_runtime — "1": anything compiling the emitted C
//                     must link libaether (same key c.aether_objects
//                     publishes, so c.program's runtime-link logic
//                     fires without special-casing).
//
// Compile-only by nature (a source package has no run step): active
// under --compile-only, inert under --execute-only; artifact writes
// run in both passes so dependents resolve paths either way. The
// AEB_COMPILE_CONTAINER per-step delegation seam is honoured via the
// shared _shell_out_ae_build.
builder csrc(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    src_name = _default_source_name(ctx)
    if _builder != null {
        if map.has(_builder, "source") == 1 {
            src_name, _ = map.get(_builder, "source")
        }
    }
    src_path = path.join(source_dir, src_name)

    out_name = csrc_default_output(src_name)
    if _builder != null {
        if map.has(_builder, "output") == 1 {
            out_name, _ = map.get(_builder, "output")
        }
    }
    out_base = path.join(target_dir, out_name)

    cap_csv = ""
    if _builder != null {
        if map.has(_builder, "csrc_caps") == 1 {
            cap_csv, _ = map.get(_builder, "csrc_caps")
        }
    }

    if bldr._compile_enabled() == 1 {
        println("${mod_dir}: emitting C source package (--emit=csrc)")
        rc = _shell_out_ae_build(ctx, _builder, src_path, out_base, ae_csrc_flags(cap_csv))
        if rc != 0 {
            bldr.fail(ctx, "aether csrc emit failed")
            return rc
        }
    }

    c_path = string.concat(out_base, ".c")
    h_path = string.concat(out_base, ".h")
    bldr._write_artifact(ctx, "c_source", c_path)
    bldr._write_artifact(ctx, "c_header", h_path)
    bldr._write_artifact(ctx, "c_header_dirs", target_dir)
    bldr._write_artifact(ctx, "c_needs_aether_runtime", "1")
    return 0
}

// aether.shared_lib(b) — compile an Aether module to a native SHARED LIBRARY
// (`ae build --emit=lib`), and publish it so downstream JVM/Go/Rust consumers
// auto-wire it. This is the producer half of the shared-lib story: `lib/aether`
// already CONSUMES shared libs (_collect_shared_libs threads deps' .so into a
// program link) but had no way to PRODUCE one — the asymmetry lib/go
// (build_mode "c-shared") and lib/rust (crate_type "cdylib") don't have.
//
//   aether.shared_lib(b) {
//       source("embed.ae")
//       extra_source("_embed_support.c")   // linked into the .so
//       output("libhtmlsanitizer.so")
//       caps("net")                        // optional --with= csv
//       target("wasm32-wasi")              // optional cross (aether >= 0.577)
//   }
//
// Publishes:
//   shared_lib                                    the .so path (the ask's name)
//   shared_library                                alias (tinygo_lib's key)
//   ldlibdeps                                     -> lib/java wires -Djava.library.path
//   shared_library_deps_including_transitive      -> lib/go / lib/java link path
//   c_header_dirs + c_needs_aether_runtime        if a companion .h is emitted
//
// A SEPARATE builder, not an emit() mode on program: it publishes no
// program_binary, so it must not be findable by bldr.program_binary_of — the
// same reasoning that made csrc separate. Setters (source/output/extra_source/
// caps/target/link_flag/include_dir) are program's, reused as-is.
builder shared_lib(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    lib_dir = path.join(target_dir, "lib")
    bldr._mkdirs(lib_dir)

    src_name = _default_source_name(ctx)
    if _builder != null {
        if map.has(_builder, "source") == 1 { src_name, _ = map.get(_builder, "source") }
    }
    src_path = path.join(source_dir, src_name)

    // Default output: lib<sourcebase>.so. output("...") overrides.
    out_name = string.concat("lib", string.concat(csrc_default_output(src_name), ".so"))
    if _builder != null {
        if map.has(_builder, "output") == 1 { out_name, _ = map.get(_builder, "output") }
    }
    so_path = path.join(lib_dir, out_name)

    cap_csv = ""
    if _builder != null {
        if map.has(_builder, "csrc_caps") == 1 { cap_csv, _ = map.get(_builder, "csrc_caps") }
    }

    // COMPILE phase — skipped under --execute-only (the .so was built in the
    // container pass). Artifact writes below run in both passes so dependents
    // resolve the path either way. (two-aeb duality.)
    if bldr._compile_enabled() == 1 {
        println("${mod_dir}: compiling Aether shared library (--emit=lib)")
        rc = _shell_out_ae_build(ctx, _builder, src_path, so_path,
                                 ae_lib_flags(cap_csv, _builder, source_dir))
        if rc != 0 {
            bldr.fail(ctx, "aether shared_lib build failed")
            return rc
        }
    }

    // Publish the native-lib wiring set. ldlibdeps + the transitive key are what
    // lib/java (-Djava.library.path) and lib/go read, so a JVM/Go consumer
    // dep()ing this node loads the .so with no path plumbing in the leaf.
    bldr._write_artifact(ctx, "shared_lib", so_path)
    bldr._write_artifact(ctx, "shared_library", so_path)
    bldr._write_artifact(ctx, "ldlibdeps", so_path)
    bldr._write_artifact(ctx, "shared_library_deps_including_transitive", so_path)

    // --emit=lib also emits a catalog header next to the .so; publish its dir so
    // a c.program consumer can -I it, mirroring csrc. Best-effort: only if present.
    h_path = string.concat(csrc_default_output(out_name), ".h")
    h_full = path.join(lib_dir, h_path)
    if file.exists(h_full) == 1 {
        bldr._write_artifact(ctx, "c_header_dirs", lib_dir)
        bldr._write_artifact(ctx, "c_needs_aether_runtime", "1")
    }
    return 0
}

// _test_bin_stem(src_name) — a safe binary/.c stem from a program_test source
// name: basename, drop a trailing ".ae", prefix "test_". So "probe.ae" ->
// "test_probe", "../bidi_slice.ae" -> "test_bidi_slice". Lets multiple
// program_test() builders in one node have distinct outputs. Pure; tested in
// tests/test_aether_cmd.ae.
_test_bin_stem(src_name: string) {
    base = path.basename(src_name)
    n = string.length(base)
    if n > 3 {
        tail = string.substring(base, n - 3, n)
        if string.equals(tail, ".ae") == 1 {
            base = string.substring(base, 0, n - 3)
        }
    }
    if string.length(base) == 0 { base = "program" }
    return string.concat("test_", base)
}

builder program_test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bin_dir = path.join(target_dir, "bin")
    bldr._mkdirs(bin_dir)

    src_name = _default_source_name(ctx)
    if _builder != null {
        if map.has(_builder, "source") == 1 {
            src_name, _ = map.get(_builder, "source")
        }
    }
    src_path = path.join(source_dir, src_name)
    // Name the binary + generated .c after the source stem so MULTIPLE
    // program_test() builders in one node don't clobber a shared
    // "test_program" output (only the last would have survived, silently
    // dropping the others). Single-test nodes still get a stable, unique name.
    test_stem = _test_bin_stem(src_name)
    bin_path = path.join(bin_dir, string.concat(test_stem, bldr._exe_suffix()))
    c_path = path.join(target_dir, string.concat(test_stem, ".c"))

    // COMPILE phase — skipped under --execute-only (built in the container
    // pass already). EXECUTE phase below — skipped under --compile-only.
    // Two-aeb duality: compile in container, execute on host
    // (docs/design/two-aeb-duality.md).
    if bldr._compile_enabled() == 1 {
        println("${mod_dir}: compiling Aether test")
        rc = _build_binary(ctx, _builder, src_path, bin_path, c_path)
        if rc != 0 {
            println("${mod_dir}: tests FAILED (compile)")
            bldr.fail(ctx, "aether test build failed")
            return rc
        }
    }

    if bldr._execute_enabled() == 0 {
        // --compile-only: binary built (or already present), don't run it.
        return 0
    }

    shared_libs = _collect_shared_libs(ctx)
    ld_path = _collect_ld_path(shared_libs)

    println("${mod_dir}: running Aether tests")
    run_cmd = bin_path
    if string.length(ld_path) > 0 {
        dyld_var = bldr._dyld_env_var()
        run_cmd = "${dyld_var}=${ld_path} ${bin_path}"
    }
    rc = bldr._sh(run_cmd)
    if rc != 0 {
        // aether.program_test runs one binary; non-zero exit = 1
        // logical failure. Exit-code-synthesised (no per-test report),
        // so the telemetry JSON gets `tests: null` + rc only. Runners
        // with sub-test counts (junit5, pytest, …) report finer granularity.
        bldr._record_test_result_exitcode(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "aether tests failed")
        return rc
    }
    bldr._record_test_result_exitcode(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    return 0
}

// aether.driver_test(b) — like program_test, but with binaries-
// under-test exposed as env vars and the bldr.fixture lifecycle
// (seed dirs / spawn servers / kill on cleanup) wrapped around the
// driver invocation.
//
// Use case: an Aether driver program (typically using
// contrib.aeocha) that drives a *separate* compiled binary built
// elsewhere in the build graph. The driver imports
// `contrib.aeocha`, calls os.run_capture(getenv("X_BIN"), ...) to
// spawn the binary-under-test, and asserts about its output.
//
// Lifecycle (per driver invocation):
//   1. Compile the driver .ae into a binary (same path as
//      program_test does).
//   2. Verify each binary_under_test path exists on disk.
//   3. Run synthesized fixture-pre statements (seed dirs, spawn
//      servers, sleep ready_after_ms).
//   4. Export $<NAME>_BIN for each binary_under_test.
//   5. Run the driver binary with all env vars set.
//   6. Run synthesized fixture-post (kill servers, rm dirs).
//   7. Driver's exit code → PASS (0) / FAIL (non-zero).
//
// Pairs with the bash.test fixture grammar — the same
// fixture_seed / fixture_server setters work in both closures
// because they write to the same map keys consumed by
// bldr._synth_fixture_pre/_post.
//
// What this is NOT:
//   - A test discovery mechanism. One driver per .tests-*.ae,
//     same shape as program_test.
//   - An Aeocha integration. The driver imports contrib.aeocha;
//     aeb doesn't know it exists. Exit-code is the pass/fail
//     signal.
//   - A replacement for program_test. Pure-Aether unit tests
//     stay on program_test. driver_test is for tests *driving a
//     separate binary*.
builder driver_test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    root = bldr._get(ctx, "root")

    bin_dir = path.join(target_dir, "bin")
    bldr._mkdirs(bin_dir)

    // Driver source: prefer explicit, fall back to default
    // (same convention as program_test).
    src_name = _default_source_name(ctx)
    if _builder != null {
        if map.has(_builder, "source") == 1 {
            src_name, _ = map.get(_builder, "source")
        }
    }
    src_path = path.join(source_dir, src_name)

    // Output binary: prefer explicit, default to "driver_test"
    // (program_test uses "test_program"; the rename signals
    // "this drives an out-of-process binary," not "this is the
    // program under test").
    out_name = "driver_test"
    if _builder != null {
        if map.has(_builder, "output") == 1 {
            out_name, _ = map.get(_builder, "output")
        }
    }
    bin_path = path.join(bin_dir, string.concat(out_name, bldr._exe_suffix()))
    c_path = path.join(target_dir, string.concat(out_name, ".c"))

    println("${mod_dir}: compiling Aether driver")
    rc = _build_binary(ctx, _builder, src_path, bin_path, c_path)
    if rc != 0 {
        bldr._record_test_result_exitcode(ctx, 0, 1)
        println("${mod_dir}: driver FAILED (compile)")
        bldr.fail(ctx, "aether driver build failed")
        return rc
    }

    // Drain pending records staged onto `b` by the inner closure
    // builders (binary_under_test, fixture_seed, fixture_server).
    // Inner builders execute before this body, so by the time we
    // get here the records are already on `b`. Drain them into
    // _builder for processing, then clear pending so subsequent
    // test builders in the same main() see a clean slate.
    if map.has(ctx, "_pending_binaries_under_test") == 1 {
        pending_buts, _ = map.get(ctx, "_pending_binaries_under_test")
        if list.size(pending_buts) > 0 {
            if map.has(_builder, "binaries_under_test") == 0 {
                _ed = map.put(_builder, "binaries_under_test", list.new())
            }
            buts_acc, _ = map.get(_builder, "binaries_under_test")
            pn = list.size(pending_buts)
            i = 0
            while i < pn {
                r, _ = list.get(pending_buts, i)
                list.add(buts_acc, r)
                i = i + 1
            }
            _eclear = map.put(ctx, "_pending_binaries_under_test", list.new())
        }
    }
    // Shape A: inside THIS builder's trailing block, builder_context()
    // is this builder's own config map (a `builder`'s block pushes the
    // per-call map, not the graph ctx — see bldr.build's comment). The
    // b-free sub-builders therefore staged their records onto _builder,
    // not ctx. Drain that side too, same record format.
    // (asks/driver-test-sub-builders-stage-nothing-under-shape-a.md)
    if map.has(_builder, "_pending_binaries_under_test") == 1 {
        pending_buts2, _ = map.get(_builder, "_pending_binaries_under_test")
        if list.size(pending_buts2) > 0 {
            if map.has(_builder, "binaries_under_test") == 0 {
                _ed2 = map.put(_builder, "binaries_under_test", list.new())
            }
            buts_acc2, _ = map.get(_builder, "binaries_under_test")
            pn2 = list.size(pending_buts2)
            i2 = 0
            while i2 < pn2 {
                r2, _ = list.get(pending_buts2, i2)
                list.add(buts_acc2, r2)
                i2 = i2 + 1
            }
            _eclear2 = map.put(_builder, "_pending_binaries_under_test", list.new())
        }
    }
    bldr._drain_pending_fixtures(ctx, _builder)
    bldr._drain_pending_fixtures(_builder, _builder)

    // Validate binaries-under-test exist. Resolve relative paths
    // against the workspace root so users can write
    // `binary_under_test(b, "hello") { path("target/hello/bin/hello") }`.
    buts = null
    if _builder != null {
        if map.has(_builder, "binaries_under_test") == 1 {
            buts, _ = map.get(_builder, "binaries_under_test")
        }
    }
    but_exports = list.new()
    if buts != null {
        bn = list.size(buts)
        i = 0
        while i < bn {
            rec, _ = list.get(buts, i)
            f = bldr._split_tabs(rec, 3)
            name, _ = list.get(f, 0)
            decl_path, _ = list.get(f, 1)
            env_var_override, _ = list.get(f, 2)
            // Resolve relative to workspace root.
            resolved = decl_path
            if string.length(decl_path) > 0 {
                _absq = _is_abs_path(decl_path)
                if _absq == 0 {
                    resolved = path.join(root, decl_path)
                }
            }
            if file.exists(resolved) == 0 {
                println("${mod_dir}: binary_under_test \"${name}\" not found at ${resolved}")
                println("${mod_dir}: did you forget a bldr.dep on the producing module?")
                bldr._record_test_result_exitcode(ctx, 0, 1)
                return 1
            }
            // Default env-var name is <UPPER(name)>_BIN; user may override.
            ev = env_var_override
            if string.length(ev) == 0 {
                up = bldr._upper_ascii_word(name)
                ev = string.concat(up, "_BIN")
            }
            // Render `export <EV>="<resolved>"` — a single shell
            // statement that fits into the pre slot.
            line = string.concat("export ", ev)
            line = string.concat(line, "=\"")
            line = string.concat(line, resolved)
            line = string.concat(line, "\"")
            list.add(but_exports, line)
            i = i + 1
        }
    }

    // Pull fixture records, synth pre/post, prepend the
    // binary_under_test exports so they're visible to fixture
    // server `args` strings (a fixture might want to receive a
    // path to a binary-under-test on its command line).
    fixture_seeds = null
    fixture_servers = null
    if _builder != null {
        if map.has(_builder, "fixture_seeds") == 1 {
            fixture_seeds, _ = map.get(_builder, "fixture_seeds")
        }
        if map.has(_builder, "fixture_servers") == 1 {
            fixture_servers, _ = map.get(_builder, "fixture_servers")
        }
    }
    pre_cmds = list.new()
    post_cmds = list.new()
    bn = list.size(but_exports)
    i = 0
    while i < bn {
        line, _ = list.get(but_exports, i)
        list.add(pre_cmds, line)
        i = i + 1
    }
    if bldr._has_fixtures(_builder) == 1 {
        fpre = bldr._synth_fixture_pre(fixture_seeds, fixture_servers)
        fpost = bldr._synth_fixture_post(fixture_seeds, fixture_servers)
        fn = list.size(fpre)
        i = 0
        while i < fn {
            line, _ = list.get(fpre, i)
            list.add(pre_cmds, line)
            i = i + 1
        }
        fpn = list.size(fpost)
        i = 0
        while i < fpn {
            line, _ = list.get(fpost, i)
            list.add(post_cmds, line)
            i = i + 1
        }
    }

    // The middle of the chain is the driver invocation. Compose an env prefix
    // (each `VAR="value" `) that precedes the quoted bin_path, so multiple env
    // vars coexist — the old code built the DYLD case by OVERWRITING exec_cmd,
    // which cannot carry a second var.
    shared_libs = _collect_shared_libs(ctx)
    ld_path = _collect_ld_path(shared_libs)
    env_prefix = ""
    // Rust cdylib deps: prepend the platform dyld var (same as program_test).
    if string.length(ld_path) > 0 {
        dyld_var = bldr._dyld_env_var()
        env_prefix = string.concat(env_prefix, string.concat(dyld_var, string.concat("=\"", string.concat(ld_path, "\" "))))
    }
    // std.spec report transport (the aeocha successor): AE_SPEC_FORMAT=aeocha +
    // AE_SPEC_REPORT=<file> makes a std.spec `run_summary()` child write the
    // version=1 aeocha-v1 report aeb parses — to a FILE. This is now the ONLY
    // report path: aeocha is retired and its repo archived, so nothing writes
    // the report over the old IPC pipe anymore (that channel is dead — no
    // shipping driver answers on it). We still spawn via run_pipe_drain_and_wait
    // (its spawn/wait is the working path; the pipe payload is just ignored) and
    // read the file below. Hand-rolled drivers write no report and keep the
    // exit-code fallback. The file lives in the module's target dir so it is
    // native-form on Windows and cleaned with it.
    spec_report = path.join(bldr._get(ctx, "target_dir"), "_spec_report.txt")
    _srm = bldr._sh(string.concat("rm -f \"", string.concat(spec_report, "\"")))
    env_prefix = string.concat(env_prefix, "AE_SPEC_FORMAT=aeocha ")
    env_prefix = string.concat(env_prefix, string.concat("AE_SPEC_REPORT=\"", string.concat(spec_report, "\" ")))
    exec_cmd = string.concat(env_prefix, string.concat("\"", string.concat(bin_path, "\"")))

    // Spawn the driver. run_pipe_drain_and_wait is retained as the spawn/wait
    // mechanism (it works on every platform); its pipe payload is no longer a
    // report source — see the transport note above. rc/run_err are what we use.
    println("${mod_dir}: running Aether driver")
    prog, argv = bldr._exec_chain_argv(pre_cmds, exec_cmd, post_cmds)
    _pipe_ignored, rc, run_err = os.run_pipe_drain_and_wait(prog, argv, null)
    if string.length(run_err) > 0 {
        // Spawn itself failed (binary not found, permission
        // denied, Windows fall-through, …). Distinct from the
        // driver running and exiting non-zero. No report → exit-code
        // granularity (tests: null in the JSON).
        bldr._record_test_result_exitcode(ctx, 0, 1)
        println("${mod_dir}: driver spawn error: ${run_err}")
        return 1
    }

    // The report is the AE_SPEC_REPORT file (the sole path now). Read it if the
    // std.spec child wrote it; absent → hand-rolled driver → exit-code fallback.
    // Same parser; the format is a versioned contract (aether docs/testing.md).
    report = ""
    if file.exists(spec_report) == 1 {
        fraw, _frerr = io.read_file(spec_report)
        report = fraw
    }

    passed, failed, errored, skipped, failed_names, has_report = bldr._parse_aeocha_report(report)
    if has_report == 0 {
        // No structured report — fall back to exit-code mapping
        // (preserves behaviour for hand-rolled drivers that just
        // exit 0/non-0).
        if rc == 0 {
            passed = 1
            failed = 0
        } else {
            passed = 0
            failed = 1
        }
        skipped = 0
    }

    total_failed = failed + errored
    // A genuine report → real per-it counts (tests: {…}, incl. skipped from the
    // std.spec 0.545 skip verbs); no report → exit-code-mapped 1/0 (tests: null,
    // rc only). Mirrors the for_ci_use.md granularity split.
    if has_report == 1 {
        bldr._record_test_result_skips(ctx, passed, total_failed, skipped)
    } else {
        bldr._record_test_result_exitcode(ctx, passed, total_failed)
    }
    // Persist failed-test names so the orchestrator can render
    // them under the FAIL line in [telemetry]. No-op when
    // failed_names is empty (all-pass run, or hand-rolled driver
    // with no report).
    bldr._record_test_failures(ctx, failed_names)
    if rc != 0 {
        if has_report == 1 {
            println("${mod_dir}: driver FAILED (${passed} passed, ${total_failed} failed)")
        } else {
            println("${mod_dir}: driver FAILED")
        }
        return rc
    }
    if has_report == 1 {
        println("${mod_dir}: driver PASSED (${passed}/${passed})")
    } else {
        println("${mod_dir}: driver PASSED")
    }
    return 0
}
