// Tests for tools/aebcli's parse_argv — the Aether-native port of the bash
// trampoline's whole flag loop, as a PURE argv -> directive-list interpreter.
// Asserts the exact ordered directives across permutations: boolean flags,
// value flags (incl. the next-arg consume), the implies-relations, the
// accumulating --vet-tool, synonym targets, coordinate/empty-name/missing-arg/
// bad-timeout errors (terminal), and a realistic mixed CI invocation.
//
// Directives are tab-separated: "env\tNAME\tVALUE", "env-append\tNAME\tVALUE",
// "arg\tVALUE", "synonym\tRELPATH\tFQN", "error\tCODE\tMESSAGE".

import std.spec
import std.string
import std.list

import aebcli (parse_argv, directive_kind, directive_field, env_append_value, stamp_field)

// Build an argv list from up to 5 tokens ("" = omitted).
_argv(a: string, b: string, c: string, d: string, e: string) {
    l = list.new()
    if string.length(a) > 0 { _x = list.add(l, a) }
    if string.length(b) > 0 { _x = list.add(l, b) }
    if string.length(c) > 0 { _x = list.add(l, c) }
    if string.length(d) > 0 { _x = list.add(l, d) }
    if string.length(e) > 0 { _x = list.add(l, e) }
    return l
}

// Fetch directive at index `i` of the parse result.
_at(res: ptr, i: int) {
    got, _g = list.get(res, i)
    return got
}

main() {
    fw = spec.init()

    spec.describe(fw, "parse_argv: flags and targets") {
        // a boolean flag
        spec.it("coverage boolean flag") callback {
            r1 = parse_argv(_argv("--coverage", "", "", "", ""))
            spec.assert_eq(list.size(r1), 1, "1 directive")
            spec.assert_str_eq(_at(r1, 0), "env\tAEB_COVERAGE\t1", "env")
        }
        // a value flag consumes the next token
        spec.it("scan value flag consumes next token") callback {
            r2 = parse_argv(_argv("--scan", ".tests.ae", "", "", ""))
            spec.assert_eq(list.size(r2), 1, "1 directive")
            spec.assert_str_eq(_at(r2, 0), "env\tAEB_SCAN\t.tests.ae", "env+value")
        }
        // a value flag that ALSO implies another env var
        spec.it("sbom-json implies resolve-only") callback {
            r3 = parse_argv(_argv("--sbom-json", "out.json", "", "", ""))
            spec.assert_eq(list.size(r3), 2, "2 directives")
            spec.assert_str_eq(_at(r3, 0), "env\tAEB_SBOM_JSON\tout.json", "env value")
            spec.assert_str_eq(_at(r3, 1), "env\tAEB_RESOLVE_ONLY\t1", "implies resolve")
        }
        // --vet-tool accumulates (env-append) and implies --vet
        spec.it("vet-tool accumulates + implies vet") callback {
            r4 = parse_argv(_argv("--vet-tool", "semgrep --error .", "", "", ""))
            spec.assert_eq(list.size(r4), 2, "2 dirs")
            spec.assert_str_eq(_at(r4, 0), "env-append\tAEB_VET_TOOLS\tsemgrep --error .", "append")
            spec.assert_str_eq(_at(r4, 1), "env\tAEB_VET\t1", "implies vet")
        }
        // a plain target passthrough
        spec.it("plain target arg") callback {
            r5 = parse_argv(_argv("app/.build.ae", "", "", "", ""))
            spec.assert_str_eq(_at(r5, 0), "arg\tapp/.build.ae", "plain target")
        }
        // a synonym target
        spec.it("synonym target") callback {
            r6 = parse_argv(_argv("app:build", "", "", "", ""))
            spec.assert_eq(list.size(r6), 1, "1 directive")
            spec.assert_str_eq(_at(r6, 0), "synonym\tapp/.build.ae\tapp/.build.ae", "synonym")
        }
        spec.it("bare synonym target") callback {
            r6b = parse_argv(_argv(":build", "", "", "", ""))
            spec.assert_str_eq(_at(r6b, 0), "synonym\t./.build.ae\t.build.ae", "bare synonym")
        }
        // an unknown option passes through (bash `else` branch)
        spec.it("unknown flag passes through") callback {
            r12 = parse_argv(_argv("--frobnicate", "", "", "", ""))
            spec.assert_str_eq(_at(r12, 0), "arg\t--frobnicate", "unknown passes")
        }
    }

    spec.describe(fw, "parse_argv: errors are terminal") {
        // coordinate (exit 2)
        spec.it("coordinate is terminal") callback {
            r7 = parse_argv(_argv("org.corp:lib:1.0", "ignored", "", "", ""))
            spec.assert_eq(list.size(r7), 1, "1 directive (terminal)")
            spec.assert_str_eq(_at(r7, 0),
                "error\t2\taeb: 'org.corp:lib:1.0' looks like a coordinate, not a target (a target is 'path/to:name' or ':name')",
                "coordinate error")
        }
        // empty synonym name (exit 2)
        spec.it("empty synonym name errors") callback {
            r8 = parse_argv(_argv("app:", "", "", "", ""))
            spec.assert_str_eq(_at(r8, 0),
                "error\t2\taeb: empty target name in synonym 'app:' (use 'path/to:name' or ':name')",
                "empty-name error")
        }
        // value flag at end of argv (exit 1)
        spec.it("value flag missing its arg errors") callback {
            r9 = parse_argv(_argv("--scan", "", "", "", ""))
            spec.assert_str_eq(_at(r9, 0), "error\t1\taeb: --scan requires an argument", "missing-arg error")
        }
        // non-numeric --timeout (exit 1)
        spec.it("non-numeric --timeout errors") callback {
            r10 = parse_argv(_argv("--timeout", "soon", "", "", ""))
            spec.assert_str_eq(_at(r10, 0),
                "error\t1\taeb: --timeout must be a whole number of seconds, got 'soon'", "bad-timeout error")
        }
        // numeric --timeout is fine
        spec.it("numeric --timeout is fine") callback {
            r10b = parse_argv(_argv("--timeout", "600", "", "", ""))
            spec.assert_str_eq(_at(r10b, 0), "env\tAEB_TIMEOUT\t600", "good-timeout env")
        }
    }

    spec.describe(fw, "parse_argv: realistic mixed CI invocation") {
        //   aeb --coverage --scan .tests.ae app:build
        spec.it("flags + a synonym target") callback {
            r11 = parse_argv(_argv("--coverage", "--scan", ".tests.ae", "app:build", ""))
            spec.assert_eq(list.size(r11), 3, "3 directives")
            spec.assert_str_eq(_at(r11, 0), "env\tAEB_COVERAGE\t1", "coverage")
            spec.assert_str_eq(_at(r11, 1), "env\tAEB_SCAN\t.tests.ae", "scan")
            spec.assert_str_eq(_at(r11, 2), "synonym\tapp/.build.ae\tapp/.build.ae", "target")
        }
    }

    spec.describe(fw, "directive accessors (used by the executor)") {
        spec.it("directive_kind") callback {
            spec.assert_str_eq(directive_kind("env\tAEB_SCAN\t.tests.ae"), "env", "kind of env")
            spec.assert_str_eq(directive_kind("synonym\ta/.b.ae\ta/.b.ae"), "synonym", "kind of synonym")
        }
        spec.it("directive_field by index") callback {
            spec.assert_str_eq(directive_field("env\tA\t1", 0), "env", "field 0")
            spec.assert_str_eq(directive_field("env\tA\t1", 1), "A", "field 1")
            spec.assert_str_eq(directive_field("env\tA\t1", 2), "1", "field 2")
            spec.assert_str_eq(directive_field("env-append\tAEB_VET_TOOLS\tsemgrep --error .", 2),
                "semgrep --error .", "field 2 with spaces")
            spec.assert_str_eq(directive_field("arg\tx", 2), "", "field beyond end empty")
        }
    }

    spec.describe(fw, "env_append_value: the --vet-tool accumulation rule") {
        spec.it("append to empty") callback {
            spec.assert_str_eq(env_append_value("", "a"), "a", "append to empty")
        }
        spec.it("append joins with newline") callback {
            spec.assert_str_eq(env_append_value("a", "b"), "a\nb", "join newline")
        }
        spec.it("append chains") callback {
            spec.assert_str_eq(env_append_value("a\nb", "c"), "a\nb\nc", "chains")
        }
    }

    spec.describe(fw, "stamp_field: --version provenance extraction") {
        spec.it("src token") callback {
            spec.assert_str_eq(stamp_field("src abc123\ncommit deadbeef\n", "src"), "abc123", "src")
        }
        spec.it("commit token") callback {
            spec.assert_str_eq(stamp_field("src abc123\ncommit deadbeef\n", "commit"), "deadbeef", "commit")
        }
        spec.it("multi-word value") callback {
            spec.assert_str_eq(stamp_field("installed 2026-06-11 by make\n", "installed"),
                "2026-06-11 by make", "multi-word")
        }
        spec.it("missing key → empty") callback {
            spec.assert_str_eq(stamp_field("src abc\n", "toolchain"), "", "missing key")
        }
        spec.it("last line without trailing newline") callback {
            spec.assert_str_eq(stamp_field("a 1\nb 2", "b"), "2", "last line no nl")
        }
        // The `version` field a released payload carries (the tag). Present →
        // aeb --version reports the tag; absent → the caller falls back to
        // 0.0.0-dev+<src>. (asks/aeb-version-does-not-embed-the-release-tag.md)
        spec.it("version token present → the release tag") callback {
            spec.assert_str_eq(
                stamp_field("src abc\ncommit unknown\nversion v0.295\n", "version"),
                "v0.295", "version tag")
        }
        spec.it("version token absent → empty (fall back to 0.0.0-dev)") callback {
            spec.assert_str_eq(
                stamp_field("src abc\ncommit deadbeef\n", "version"), "", "no version field")
        }
    }

    return spec.run_summary(fw)
}
