#!/usr/bin/env bash
# aeb — Aether Build runner (thin trampoline)
#
# Sets up a few environment values that are awkward to compute from inside
# Aether (AETHER, AEB_HOME, ROOT, optional Podman socket), then execs the
# Aether-language entry point in tools/aeb-main. Everything else — argument
# parsing, scan/target-mode discovery, dep extraction, topo sort, per-file
# compile, orchestrator generation, gcc link, and final exec of the build
# binary — lives in tools/aeb-main.ae and the helper tools it shells out to.
#
# This script uses only POSIX-level bash features (no associative arrays,
# no `${var^^}` case magic) so it runs on macOS default bash 3.2 as well
# as on modern Linux bash 4/5.
set -eo pipefail

# Did the USER pin $AETHER, or are we defaulting? Must be captured BEFORE the
# default is applied — `AETHER="${AETHER:-ae}"` makes AETHER set either way,
# so testing it afterwards can never distinguish the two (it can't; asked and
# answered by a confused trace).
_aeb_user_pinned_aether=0
if [ -n "${AETHER+x}" ]; then _aeb_user_pinned_aether=1; fi
AETHER="${AETHER:-ae}"
AEB_HOME="$(cd "$(dirname "$0")" && pwd)"
export AEB_HOME

# --- Windows: give every tool a NATIVE-form temp dir -----------------------
#
# On MSYS2/MinGW the aeb tools write throwaway shell scripts with Aether's
# std.io (a native Win32 fopen) and then run them with `sh`. A native "C:/.."
# path is read identically by both; a POSIX "/tmp/.." is NOT — io.write_file
# resolves it as C:\tmp while `sh` reads it as C:\msys64\tmp, so the script is
# written to one dir and executed from another and the build dies with
# `sh: /tmp/_aeb_*.sh: No such file or directory`. (Full write-up:
# asks/windows-two-path-form-bugs-aeb-link-and-tmp.md.)
#
# Each tool tries to fix this itself via cygpath, but that call is unreliable
# several process-levels deep (make → orchestrator → aeb-link → transform-ae):
# a bare cygpath resolves through cmd.exe's PATH, which differs by nesting. The
# robust fix is ONE normalisation here, up front: export TMP/TEMP in native
# form so every descendant inherits a temp dir both worlds read the same way.
# Only touches Windows; leaves a already-native value alone.
case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
        _aeb_tmp="${TMP:-${TEMP:-${TMPDIR:-/tmp}}}"
        # Native already (drive letter or UNC)? Leave it. Else convert.
        case "$_aeb_tmp" in
            [A-Za-z]:/*|[A-Za-z]:\\*|//*|\\\\*) : ;;
            *)
                if command -v cygpath >/dev/null 2>&1; then
                    _aeb_tmp_native="$(cygpath -m "$_aeb_tmp" 2>/dev/null)"
                    if [ -n "$_aeb_tmp_native" ]; then _aeb_tmp="$_aeb_tmp_native"; fi
                fi
                ;;
        esac
        TMP="$_aeb_tmp"; TEMP="$_aeb_tmp"
        export TMP TEMP
        unset _aeb_tmp _aeb_tmp_native
        ;;
esac

# --- aeb's OWN Aether: pinned, private, never the user's ------------------
#
# TWO Aethers, deliberately (asks/two-aethers-pinned-toolchain-vs-declared-dep.md):
#
#   1. THIS one compiles `.foo.ae` build files into aeb's orchestrator. It is
#      an implementation detail of the aeb release — like the gcc that built
#      your `make` binary — so aeb pins it (AETHER_PIN) and will fetch it into
#      its own cache if what is on PATH is too old.
#   2. The user's `ae` compiles the USER's program, inside aether.program().
#      Untouched. Never shadowed, never upgraded, never on aeb's conscience.
#      `which ae` answers the same before and after aeb runs.
#
# The failure this removes: aeb-driver calls os.spawn_proc (aether 0.442+).
# On a box with 0.413 that surfaced as `E0301: Undefined function
# 'os.spawn_proc'` inside a GENERATED file the user never wrote — followed by
# a human bisecting Aether versions. Now aeb just fetches what it needs.
#
# Off switches, in precedence order:
#   AETHER=<path>          explicit — you chose, aeb obeys, no pin check
#   AEB_NO_FETCH=1         never download; assert the floor and explain
#   AEB_FETCH_SOURCE=1     skip the prebuilt tarball, build from source.
#                          For reproducing a source-only node, or when you
#                          do not want to trust an unchecksummed download.
_aeb_pin_file="$AEB_HOME/AETHER_PIN"
_aeb_pin=""
if [ -f "$_aeb_pin_file" ]; then
    _aeb_pin=$(grep -v '^#' "$_aeb_pin_file" 2>/dev/null | tr -d '[:space:]')
fi

# `0.447.0` -> `447`, `1.2.0` -> `1002`. Aether versions as 0.x.y today (x
# is the release train), so the minor is what moves — but folding major in
# as major*1000 means a future 1.x sorts ABOVE 0.449 instead of below it,
# which a naive minor-only compare gets backwards. Non-numeric or missing
# fields degrade to 0 rather than trusting the string shape.
_aeb_vnum() {
    _vs=$(printf '%s' "${1:-}" | sed -e 's/^[Vv]//')
    _vmaj=$(printf '%s' "$_vs" | sed -e 's/\..*$//')
    _vmin=$(printf '%s' "$_vs" | sed -e 's/^[0-9]*\.//' -e 's/\..*$//')
    case "$_vmaj" in ''|*[!0-9]*) _vmaj=0 ;; esac
    case "$_vmin" in ''|*[!0-9]*) _vmin=0 ;; esac
    printf '%s' "$(( _vmaj * 1000 + _vmin ))"
}

# Only when the user has NOT pinned $AETHER themselves and we know our floor.
if [ -n "$_aeb_pin" ] && [ "$_aeb_user_pinned_aether" = "0" ]; then
    _aeb_cache="${AEB_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/aeb}"
    # WHICH release to fetch is a separate question from the FLOOR.
    # AETHER_PIN is the oldest Aether that can compile aeb's sources;
    # AETHER_FETCH (optional) names a known-good release to download. They
    # differ over glibc: releases built on ubuntu-latest carry a GLIBC_2.38
    # floor whose `aetherc` dies on Debian 12 (2.36), while `ae --version`
    # still succeeds — so a version-only probe calls it healthy. Aether's
    # release.yml now pins ubuntu-22.04 (glibc 2.35).
    #
    # The cache dir is keyed on the FETCH version, not the floor: keying it
    # on the floor made a bumped AETHER_FETCH silently reuse the older tree
    # (seen: "fetching 0.452.0" landing in .../aether-0.447.0).
    _aeb_fetch_ver="$_aeb_pin"
    if [ -f "$AEB_HOME/AETHER_FETCH" ]; then
        _aeb_fv=$(grep -v '^#' "$AEB_HOME/AETHER_FETCH" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$_aeb_fv" ]; then _aeb_fetch_ver="$_aeb_fv"; fi
    fi
    _aeb_priv="$_aeb_cache/toolchain/aether-$_aeb_fetch_ver"
    if [ -x "$_aeb_priv/bin/ae" ]; then
        # Already fetched on a previous run. Silent from here on.
        AETHER="$_aeb_priv/bin/ae"
    else
        _aeb_have=$(command -v ae >/dev/null 2>&1 && ae --version 2>/dev/null | head -1 | sed -e 's/^ae //' -e 's/ .*$//' || printf '')
        if [ "$(_aeb_vnum "$_aeb_have")" -lt "$(_aeb_vnum "$_aeb_pin")" ]; then
            if [ "${AEB_NO_FETCH:-}" = "1" ]; then
                echo "aeb: this aeb needs aether >= $_aeb_pin to compile its own build files" >&2
                echo "aeb:   found ${_aeb_have:-none} on PATH; AEB_NO_FETCH=1 so nothing was fetched." >&2
                echo "aeb:   install it, or unset AEB_NO_FETCH to let aeb fetch a private copy," >&2
                echo "aeb:   or set AETHER=/path/to/ae to choose one explicitly." >&2
                exit 2
            fi
            echo "aeb: fetching aether $_aeb_fetch_ver for aeb's own use (one-time, $_aeb_priv)" >&2
            echo "aeb:   your own \`ae\` (${_aeb_have:-none}) is left alone." >&2
            mkdir -p "$_aeb_cache/toolchain"
            _aeb_ok=0
            # The log lives OUTSIDE $_aeb_priv on purpose: the prebuilt path
            # rm -rf's that dir to swap in the staged tree, which would take
            # an inside-log with it — and the failure message below points
            # users at this file precisely when things went wrong.
            _aeb_log="$_aeb_cache/toolchain/fetch-$_aeb_fetch_ver.log"
            : >"$_aeb_log" 2>/dev/null || true

            # --- Attempt 1: the PREBUILT release tarball -------------------
            #
            # Measured on one box, v0.472.0: prebuilt = under 1 s; source
            # build via get.sh = 69 s AND needs a C compiler + GNU make on
            # the node. Upstream publishes linux-x86_64, macos-arm64,
            # macos-x86_64, windows-x86_64 and (since 0.472.0) freebsd-x86_64.
            #
            # This is attempt ONE, not the only path, because the asset set
            # varies by release and by platform: freebsd appeared only in
            # 0.472.0, and there is no linux-arm64 asset at all (a Pi or a
            # Graviton node has nothing to download). Anything unmapped or
            # unpublished falls through to the source build below, which is
            # why that path stays.
            #
            # NOT VERIFIED AGAINST A PUBLISHED CHECKSUM — upstream ships no
            # .sha256 alongside these assets (checked). So the integrity gate
            # here is the COMPILE PROBE below, not a hash. Stated plainly
            # rather than implied: this trusts TLS + GitHub, the same trust
            # the source path already places in the tarball it downloads.
            _aeb_os=""
            _aeb_ext="tar.gz"
            case "$(uname -s)" in
                Linux)   _aeb_os="linux" ;;
                Darwin)  _aeb_os="macos" ;;
                FreeBSD) _aeb_os="freebsd" ;;
                # MSYS/MinGW/Cygwin all report a compound name here.
                MINGW*|MSYS*|CYGWIN*) _aeb_os="windows"; _aeb_ext="zip" ;;
            esac
            _aeb_arch=""
            case "$(uname -m)" in
                x86_64|amd64)  _aeb_arch="x86_64" ;;
                arm64|aarch64) _aeb_arch="arm64" ;;
            esac
            # macos-arm64 exists; linux-arm64 does not. Only ask for a
            # combination upstream actually publishes — a 404 costs a
            # round-trip and muddies the fetch log for no gain.
            _aeb_asset=""
            if [ -n "$_aeb_os" ] && [ -n "$_aeb_arch" ]; then
                case "$_aeb_os-$_aeb_arch" in
                    linux-x86_64|macos-arm64|macos-x86_64|windows-x86_64|freebsd-x86_64)
                        _aeb_asset="aether-$_aeb_fetch_ver-$_aeb_os-$_aeb_arch.$_aeb_ext" ;;
                esac
            fi

            if [ -n "$_aeb_asset" ] && [ "${AEB_FETCH_SOURCE:-}" != "1" ]; then
                _aeb_tmp="$_aeb_cache/toolchain/.dl-$_aeb_fetch_ver.$$"
                rm -rf "$_aeb_tmp"; mkdir -p "$_aeb_tmp"
                printf 'trying prebuilt asset: %s\n' "$_aeb_asset" >>"$_aeb_log" 2>&1
                if curl -fsSL -o "$_aeb_tmp/$_aeb_asset" \
                     "https://github.com/aether-lang-dev/aether/releases/download/v$_aeb_fetch_ver/$_aeb_asset" \
                     >>"$_aeb_log" 2>&1; then
                    # NO --strip-components: these archives have no wrapper
                    # dir, they extract bin/ include/ lib/ share/ directly.
                    # Stripping a level flattens bin/ae to ./ae and the probe
                    # below then fails — this exact bug hit release.yml's
                    # verify step on its first CI run.
                    if [ "$_aeb_ext" = "zip" ]; then
                        ( cd "$_aeb_tmp" && unzip -q "$_aeb_asset" ) >>"$_aeb_log" 2>&1 || true
                    else
                        tar xzf "$_aeb_tmp/$_aeb_asset" -C "$_aeb_tmp" >>"$_aeb_log" 2>&1 || true
                    fi
                    # PROBE BY COMPILING, not by `--version`. A prebuilt can
                    # pass the version banner and still be unable to compile:
                    # v0.449.0's aetherc needed GLIBC_2.38 and died on Debian
                    # 12 (glibc 2.36) while `ae --version` answered happily.
                    # A version-only check would install that and hand the
                    # user a toolchain that fails at first build. Since there
                    # is no published checksum, this probe is ALSO the only
                    # integrity signal we get — so it is not optional.
                    if [ -x "$_aeb_tmp/bin/ae" ]; then
                        printf 'main() { println("aeb_probe_ok") \n return 0 }\n' \
                            > "$_aeb_tmp/_probe.ae"
                        if "$_aeb_tmp/bin/ae" run "$_aeb_tmp/_probe.ae" 2>>"$_aeb_log" \
                             | grep -q aeb_probe_ok; then
                            rm -f "$_aeb_tmp/_probe.ae" "$_aeb_tmp/$_aeb_asset"
                            # Populate the real dir only after the probe
                            # passes, so a half-extracted or broken toolchain
                            # never becomes the cached one a later run trusts
                            # (the `-x $_aeb_priv/bin/ae` short-circuit above
                            # would happily reuse it forever).
                            rm -rf "$_aeb_priv"
                            if mv "$_aeb_tmp" "$_aeb_priv" 2>>"$_aeb_log"; then
                                AETHER="$_aeb_priv/bin/ae"
                                _aeb_ok=1
                                echo "aeb: aether $_aeb_fetch_ver ready (prebuilt $_aeb_os-$_aeb_arch)." >&2
                            fi
                        fi
                    fi
                fi
                rm -rf "$_aeb_tmp"
                if [ "$_aeb_ok" = "0" ]; then
                    echo "aeb:   no usable prebuilt for $_aeb_os-$_aeb_arch; building from source (~1-2 min)." >&2
                fi
            elif [ "${AEB_FETCH_SOURCE:-}" = "1" ]; then
                echo "aeb:   AEB_FETCH_SOURCE=1 — skipping the prebuilt, building from source." >&2
            else
                echo "aeb:   no prebuilt published for $(uname -s)/$(uname -m); building from source (~1-2 min)." >&2
            fi

            # --- Attempt 2: build from source via upstream's get.sh --------
            #
            # The fallback that makes the above safe to try: it works on any
            # platform upstream has no asset for (linux-arm64 today), and on
            # any release whose asset set is incomplete. Costs ~69 s and a C
            # compiler, which is the price of not being locked to the five
            # published targets.
            if [ "$_aeb_ok" = "0" ]; then
                mkdir -p "$_aeb_priv"
                _aeb_get="$_aeb_cache/toolchain/get-$_aeb_fetch_ver.sh"
                if curl -sSL -o "$_aeb_get" \
                     "https://raw.githubusercontent.com/aether-lang-dev/aether/v$_aeb_fetch_ver/get.sh" 2>/dev/null \
                   && AETHER_REF="v$_aeb_fetch_ver" PREFIX="$_aeb_priv" sh "$_aeb_get" >>"$_aeb_log" 2>&1 \
                   && [ -x "$_aeb_priv/bin/ae" ]; then
                    AETHER="$_aeb_priv/bin/ae"
                    _aeb_ok=1
                    echo "aeb: aether $_aeb_fetch_ver ready (built from source)." >&2
                fi
            fi

            if [ "$_aeb_ok" = "0" ]; then
                echo "aeb: could not fetch aether $_aeb_fetch_ver (see $_aeb_log)." >&2
                echo "aeb:   falling back to ${_aeb_have:-ae} on PATH — the build may fail with" >&2
                echo "aeb:   'E0301: Undefined function' if it lacks a primitive aeb needs." >&2
            fi
        fi
    fi
fi
# Absolute path to THIS trampoline, so a tool that needs to re-invoke aeb
# (e.g. aeb-remote running `aeb --prereqs <target>` to derive a toolchain
# image, ladder Rung 3) hits the same aeb, not a different one on PATH.
AEB_SELF="$AEB_HOME/$(basename "$0")"
export AEB_SELF
ROOT="$(pwd)"

# --- --version: aeb provenance (from AEB_STAMP) + underlying ae ---
# AEB_STAMP is written by `make install`; it pins the source-content
# hash, git describe, install time, and the toolchain that prebuilt
# tools/. So every installed aeb self-identifies precisely — a stale
# or wrong tree can't masquerade. A tree with no stamp is an
# un-installed (dev) checkout, and says so.
if [[ "${1:-}" == "--version" ]]; then
    stamp="$AEB_HOME/AEB_STAMP"
    if [[ -f "$stamp" ]]; then
        src=$(awk '$1=="src"{print $2}' "$stamp")
        commit=$(awk '$1=="commit"{print $2}' "$stamp")
        installed=$(awk '$1=="installed"{sub(/^installed /,"");print}' "$stamp")
        toolchain=$(awk '$1=="toolchain"{sub(/^toolchain /,"");print}' "$stamp")
        # A released payload carries a `version` field (the tag, e.g. v0.294)
        # that make install copied from the bundled VERSION file. The payload
        # has no .git, so `git describe` in AEB_STAMP's `commit` is "unknown" —
        # this field is how a released install reports its TAG rather than a
        # generic 0.0.0-dev. Source `make install` writes no VERSION file, so
        # the field is absent and we keep 0.0.0-dev+<src>, correctly marking a
        # dev build. (asks/aeb-version-does-not-embed-the-release-tag.md)
        version=$(awk '$1=="version"{print $2}' "$stamp")
        ver="0.0.0-dev+${src}"
        [[ -n "$version" ]] && ver="$version"
        echo "aeb ${ver}   (git ${commit}, installed ${installed})"
        echo "  AEB_HOME     $AEB_HOME"
        echo "  tools built  ${toolchain}"
    else
        echo "aeb 0.0.0-dev   (no AEB_STAMP — un-installed tree at $AEB_HOME)"
    fi
    "$AETHER" --version 2>/dev/null | head -1
    exit 0
fi

# Auto-detect podman socket for TestContainers
if [[ -z "${DOCKER_HOST:-}" ]] && [[ -S "/run/user/$(id -u)/podman/podman.sock" ]]; then
    export DOCKER_HOST="unix:///run/user/$(id -u)/podman/podman.sock"
fi

# --- --init: no longer needed ---
# aeb resolves its SDKs from its own install ($AEB_HOME/lib) unconditionally —
# there is no per-project .aeb/lib symlink farm to create. A fresh clone just
# builds. This stub stays so `aeb --init` in old scripts prints guidance instead
# of erroring, and tells the user to delete any stale .aeb/lib a prior init left.
if [[ "${1:-}" == "--init" ]]; then
    echo "aeb: --init is obsolete — aeb builds against its own SDK ($AEB_HOME/lib);"
    echo "aeb:   no per-project .aeb/lib is needed. Just run 'aeb <target>'."
    echo "aeb:   If a previous init left a .aeb/lib symlink farm, remove it: rm -rf .aeb/lib"
    exit 0
fi

# --- gcheckout: lazy-build and exec the sparse-checkout tool ---
# Routes `aeb gcheckout ...` to tools/gcheckout, which walks the .ae-file
# DAG and adds each visited module's directory to git sparse-checkout.
if [[ "${1:-}" == "gcheckout" ]]; then
    GCHECKOUT_BIN="$AEB_HOME/tools/gcheckout"
    if [[ ! -x "$GCHECKOUT_BIN" ]]; then
        "$AETHER" build "$AEB_HOME/tools/gcheckout.ae" -o "$GCHECKOUT_BIN" 2>/dev/null
    fi
    shift
    exec "$GCHECKOUT_BIN" "$@"
fi

# Note: the remote-aeb build agent is a SEPARATE binary `aeb-agent`
# (installed at $PREFIX/bin/aeb-agent), NOT an `aeb agent` subcommand —
# so a sysop probes "does this machine have the agent capability" by
# whether `aeb-agent` is on PATH. See docs/run-policy-class-and-cloud-
# leverage.md and the aeb-agent wrapper the Makefile installs.

# --- --watch: dev-loop wrapper, watches source dirs and re-runs aeb ---
# Composes with cache + affected-target detection: a save fires inotify
# (or fswatch on macOS), the changed paths flow through the
# affected-target walk, and only impacted targets rebuild — most of
# them cache-hit. gcheckout-aware: only watches dirs that actually
# exist on disk (sparse-checkout may have hidden some).
if [[ "${1:-}" == "--watch" ]]; then
    shift
    exec "$AEB_HOME/tools/aeb-watch" "$@"
fi

# --- --coverage: cross-cutting build flag exported to SDK builders ---
# Set once at the CLI; SDKs that know what coverage means for their
# language honor it (e.g. lib/aether passes --coverage to ae build /
# adds --coverage -O0 to its gcc invocation; cache key segregates
# coverage builds from regular ones). SDKs without a coverage flow
# (bash.test, etc.) ignore the env var.
#
# --scan '<glob>': SCAN MODE — walk the whole tree and build every
# .ae node whose basename matches the glob. This is the explicit,
# scoped counterpart to the main `aeb path/to/.leaf.ae` target mode:
# a glob is REQUIRED (no bare whole-tree build), so the scanned set
# is always named. POSIX fnmatch (`*`, `?`, `[abc]`) on the file's
# basename, so `.tests.ae` matches both `lib/foo/.tests.ae` and
# `apps/bar/.tests.ae`. CI shapes:
#   aeb --scan '.tests.ae'                 # every test target
#   aeb --since main --scan '.tests.ae'    # PR-impacted tests only
#   aeb --vet --scan '.build.ae'           # vet then build the set
# (Replaces the former --pattern flag.)
#
# Synonym target `path/to:name` (or bare `:name` in the cwd) is the
# secondary spelling of the primary `path/to/.name.ae`. It resolves to
# that one file (one node per .name.ae — aeb does NOT do Bazel's many-
# targets-per-file) and echoes the canonical FQN as
# `aeb synonym match: <path>` so the short form always teaches the long
# one. A 2+-colon token (e.g. a Maven `org.corp:lib:1.0`) is rejected as
# a coordinate, not a target.
#
# --vet / --veto-policy <path> / --vet-tool <cmd>: the supply-chain
# veto (see docs/build-veto-and-sandbox.md). --vet-tool names an
# external scanner (semgrep, a secret/CVE tool) run before the build;
# a non-zero exit vetoes (fail-closed — even command-not-found). All
# three imply --vet; --vet-tool is repeatable.
#
# --shard N/M: after --since/--scan filtering, deterministically
# keeps only the Nth shard out of M sorted targets. CI owns runner
# distribution; aeb owns stable target partitioning.
#
# These flags are consumed by position-agnostic strip: their position
# in argv doesn't matter, and they compose with each other and
# with --since / target args.
ARGS=()
i=1
while [[ $i -le $# ]]; do
    a="${!i}"
    if [[ "$a" == "--coverage" ]]; then
        export AEB_COVERAGE=1
    elif [[ "$a" == "--in-process" ]]; then
        # Opt out of the default per-node subprocess mode: run the
        # all-in-one in-process orchestrator (faster for small builds,
        # simplest to debug; tool output streams onto aeb's stdout).
        export AEB_IN_PROCESS=1
    elif [[ "$a" == "--compile-only" ]]; then
        # Two-aeb duality (docs/two-aeb-duality.md): run the build, but each
        # builder COMPILES and does NOT execute (no running produced binaries
        # / tests). The orchestrator still walks the whole DAG and compiles
        # every node; only the execute steps are suppressed. aeb-ctr runs this
        # IN the container (compiles land on the host via the mount).
        export AEB_COMPILE_ONLY=1
    elif [[ "$a" == "--execute-only" ]]; then
        # The mirror: skip every compile; for each node run only its execute
        # step (run binaries/tests on the host, with the host's runtimes).
        # aeb-ctr runs this on the HOST against the artifacts the container
        # pass produced. Composite exes carry their dep closure, so no
        # ordering manifest is needed — the same DAG walk drives both passes.
        export AEB_EXECUTE_ONLY=1
    elif [[ "$a" == "--noexe" ]]; then
        # Legacy/low-level: compile the orchestrator binary but don't run it
        # at all (stops in aeb-link). Superseded by --compile-only for the
        # duality; kept for direct orchestrator-only use.
        export AEB_NOEXE=1
    elif [[ "$a" == "--scan" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --scan requires a glob argument (e.g. --scan '.tests.ae')" >&2
            exit 1
        fi
        export AEB_SCAN="${!i}"
    elif [[ "$a" == "--shard" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --shard requires N/M (e.g. --shard 2/8)" >&2
            exit 1
        fi
        export AEB_SHARD="${!i}"
    elif [[ "$a" == "--telemetry-json" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --telemetry-json requires an output path" >&2
            exit 1
        fi
        export AEB_TELEMETRY_JSON="${!i}"
    elif [[ "$a" == "--agents" ]]; then
        # --agents <file>: a pool of remote build-agent nodes for
        # agent.dispatch to LEASE from (one `<url> - <token>` per line;
        # # comments + blanks ignored). lib/agent /pings each node in
        # file order and dispatches to the first reachable + authenticated
        # + purpose-accepting + non-busy node (matching on_platform if
        # set). Resolved to an absolute path so it survives aeb's chdir
        # into module dirs at build time. See docs.
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --agents requires a pool file path" >&2
            exit 1
        fi
        _agents_file="${!i}"
        if [[ ! -f "$_agents_file" ]]; then
            echo "aeb: --agents file not found: $_agents_file" >&2
            exit 1
        fi
        export AEB_AGENTS="$(cd "$(dirname "$_agents_file")" && pwd)/$(basename "$_agents_file")"
    elif [[ "$a" == "--use-remote-agents" ]]; then
        # --use-remote-agents: offload THIS build to a leased remote
        # aeb-agent instead of building locally. Routes to tools/aeb-remote,
        # which names the current git HEAD as the base + sends `git diff
        # HEAD` as the patch, leases from the --agents pool, dispatches, and
        # folds the remote verdict. Requires --agents (a pool to lease from).
        export AEB_USE_REMOTE_AGENTS=1
    elif [[ "$a" == "--artifacts-json" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --artifacts-json requires an output path" >&2
            exit 1
        fi
        export AEB_ARTIFACTS_JSON="${!i}"
    elif [[ "$a" == "--tests-json" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --tests-json requires an output path" >&2
            exit 1
        fi
        export AEB_TESTS_JSON="${!i}"
    elif [[ "$a" == "--resolve-only" ]]; then
        # Tier B — supply-chain SBOM. Resolve the target's dependency
        # coordinates to their full transitive closure and emit it, WITHOUT
        # building. Feeds a CVE/banned-dep scanner (e.g. aeb --vet-tool
        # 'grype sbom:out.json'). aeb emits the SBOM; the scanner judges.
        export AEB_RESOLVE_ONLY=1
    elif [[ "$a" == "--sbom-json" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --sbom-json requires an output path (or - for stdout)" >&2
            exit 1
        fi
        export AEB_SBOM_JSON="${!i}"
        export AEB_RESOLVE_ONLY=1   # naming an output implies --resolve-only
    elif [[ "$a" == "--trace-intent" ]]; then
        # Tier C — doppelganger intent trace. Compile+run the target against a
        # shadowed std.os whose os.system/exec/run* RECORD the command instead
        # of executing it, then emit the recorded intent. The build's effects
        # NEVER fire — you see what it WOULD do. (Spike; honest limits in
        # docs/build-veto-and-sandbox.md.)
        export AEB_TRACE_INTENT=1
    elif [[ "$a" == "--intent-json" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --intent-json requires an output path (or - for stdout)" >&2
            exit 1
        fi
        export AEB_INTENT_JSON="${!i}"
        export AEB_TRACE_INTENT=1   # naming an output implies --trace-intent
    elif [[ "$a" == "--timeout" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --timeout requires a value in seconds (e.g. --timeout 600)" >&2
            exit 1
        fi
        if ! [[ "${!i}" =~ ^[0-9]+$ ]]; then
            echo "aeb: --timeout must be a whole number of seconds, got '${!i}'" >&2
            exit 1
        fi
        export AEB_TIMEOUT="${!i}"
    elif [[ "$a" == "--vet" ]]; then
        # --vet: treat this build's own .ae graph as untrusted and run the
        # supply-chain veto (lib/veto, 2b AST layer) before building each
        # target. Operator decision — a dispatch/.build.ae can't clear it.
        # Policy: --veto-policy <path>, else $AEB_HOME/veto/default.ae, else
        # the built-in default rules. Enforcement (path resolution, refuse a
        # policy inside the build tree, the zero-rules lint, per-target
        # veto.check) is Aether-side in tools/aeb-main. See
        # docs/build-veto-and-sandbox.md.
        export AEB_VET=1
    elif [[ "$a" == "--veto-policy" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --veto-policy requires a policy.ae path" >&2
            exit 1
        fi
        _vp="${!i}"
        if [[ ! -f "$_vp" ]]; then
            echo "aeb: --veto-policy file not found: $_vp" >&2
            exit 1
        fi
        # Absolute-resolve so it survives aeb's chdir into module dirs.
        export AEB_VETO_POLICY="$(cd "$(dirname "$_vp")" && pwd)/$(basename "$_vp")"
        export AEB_VET=1   # naming a policy implies --vet
    elif [[ "$a" == "--vet-tool" ]]; then
        # Layer 1b — external-tool hook. --vet-tool <cmd> names an
        # operator-chosen scanner (semgrep / python3 scan.py / a secret-
        # or-CVE tool). aeb runs it with the build root as cwd BEFORE the
        # build; a NON-ZERO exit vetoes (refuse, exit 3). aeb invokes a
        # SAST engine rather than becoming one. Repeatable: every
        # --vet-tool is run, any one failing vetoes. Implies --vet.
        # Fail-closed: a tool that can't be run is itself a veto.
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --vet-tool requires a command (e.g. --vet-tool 'semgrep --error .')" >&2
            exit 1
        fi
        # Accumulate one command per newline (commands may contain spaces).
        if [[ -z "${AEB_VET_TOOLS:-}" ]]; then
            export AEB_VET_TOOLS="${!i}"
        else
            export AEB_VET_TOOLS="${AEB_VET_TOOLS}"$'\n'"${!i}"
        fi
        export AEB_VET=1   # naming a tool implies --vet
    elif [[ "$a" == "--sandbox" ]]; then
        # Layer 3 — runtime containment. Run the whole build under Aether's
        # spawn_sandboxed with a deny-by-default grant profile (LD_PRELOAD
        # propagates to the whole subtree: gcc/javac/cargo/…), so a denied
        # syscall (connect to an un-granted host, write outside target/,
        # exec off the allowlist) dies at the libc boundary regardless of
        # how the build computed it. Profile: --sandbox-profile <path>, else
        # $AEB_HOME/sandbox/default.ae, else the conservative built-in (no
        # tcp). Linux-only. See docs/build-veto-and-sandbox.md +
        # docs/capability-entrypoint.md.
        export AEB_SANDBOX=1
    elif [[ "$a" == "--sandbox-profile" ]]; then
        i=$((i + 1))
        if [[ $i -gt $# ]]; then
            echo "aeb: --sandbox-profile requires a profile.ae path" >&2
            exit 1
        fi
        _sp="${!i}"
        if [[ ! -f "$_sp" ]]; then
            echo "aeb: --sandbox-profile file not found: $_sp" >&2
            exit 1
        fi
        # Absolute-resolve so it survives aeb's chdir into module dirs.
        export AEB_SANDBOX_PROFILE="$(cd "$(dirname "$_sp")" && pwd)/$(basename "$_sp")"
        export AEB_SANDBOX=1   # naming a profile implies --sandbox
    elif [[ "$a" == *:* ]]; then
        # Synonym target address: `path/to:name` (or bare `:name` in the
        # current dir) is the secondary spelling of `path/to/.name.ae`.
        # The primary, canonical form remains the file path — so on every
        # synonym use we resolve to the real file and ECHO its FQN with a
        # predictable prefix, teaching the canonical path back to the user.
        # aeb's model is strictly one node per .name.ae file (this is what
        # keeps dep() recursion simple — we deliberately do NOT adopt
        # Bazel's many-targets-per-BUILD-file model); `:name` is pure
        # addressing sugar over that, never a second target inside a file.
        #
        # Reject coordinate-shaped tokens (2+ colons, e.g. a Maven
        # `org.corp:lib:1.0`) — those are dependency coordinates, not aeb
        # targets, and must never silently mis-resolve to a file path.
        if [[ "$a" == *:*:* ]]; then
            echo "aeb: '$a' looks like a coordinate, not a target (a target is 'path/to:name' or ':name')" >&2
            exit 2
        fi
        _syn_dir="${a%:*}"      # before the colon (empty for bare :name)
        _syn_name="${a#*:}"     # after the colon
        if [[ -z "$_syn_name" ]]; then
            echo "aeb: empty target name in synonym '$a' (use 'path/to:name' or ':name')" >&2
            exit 2
        fi
        if [[ -z "$_syn_dir" ]]; then
            _syn_path="./.${_syn_name}.ae"
        else
            _syn_path="${_syn_dir}/.${_syn_name}.ae"
        fi
        if [[ ! -f "$_syn_path" ]]; then
            _syn_scope="${_syn_dir:-.}"
            echo "aeb: synonym '$a' → no '.${_syn_name}.ae' in '${_syn_scope}/'" >&2
            exit 2
        fi
        # Normalise a leading ./ away for a tidy FQN, then echo it.
        _syn_fqn="${_syn_path#./}"
        echo "aeb synonym match: ${_syn_fqn}"
        ARGS+=("$_syn_fqn")
    else
        ARGS+=("$a")
    fi
    i=$((i + 1))
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# --- --resolve-only gate: emit the dependency-coordinate SBOM, DON'T build --
# Tier B of the supply-chain veto (docs/build-veto-and-sandbox.md). Resolve
# the named targets' declared coordinates to their transitive closure and
# emit it as JSON ({"maven":[g:a:v,...]}), then exit — no build. A scanner
# (grype/osv-scanner) consumes the SBOM, typically via `aeb --vet-tool`.
if [[ -n "${AEB_RESOLVE_ONLY:-}" ]]; then
    _sbom_targets=()
    for _a in "$@"; do
        case "$_a" in *.ae) _sbom_targets+=("$_a") ;; esac
    done
    if [[ ${#_sbom_targets[@]} -eq 0 ]]; then
        echo "aeb: --resolve-only needs a target (e.g. aeb --resolve-only app/.build.ae)" >&2
        exit 2
    fi
    AEB_SBOM_BIN="$AEB_HOME/tools/aeb-sbom"
    if [[ ! -x "$AEB_SBOM_BIN" ]]; then
        "$AETHER" build "$AEB_HOME/tools/aeb-sbom.ae" --lib "$AEB_HOME/lib" -o "$AEB_SBOM_BIN" 2>/dev/null
    fi
    _sbom_out="$("$AEB_SBOM_BIN" "$AEB_HOME" "${_sbom_targets[@]}")"
    _sbom_rc=$?
    if [[ $_sbom_rc -ne 0 ]]; then
        echo "aeb: --resolve-only failed (rc $_sbom_rc)" >&2
        exit "$_sbom_rc"
    fi
    if [[ -n "${AEB_SBOM_JSON:-}" && "${AEB_SBOM_JSON}" != "-" ]]; then
        printf '%s\n' "$_sbom_out" > "${AEB_SBOM_JSON}"
        echo "aeb: SBOM written to ${AEB_SBOM_JSON}" >&2
    else
        printf '%s\n' "$_sbom_out"
    fi
    exit 0
fi

# --- --trace-intent gate: doppelganger-trace the build, DON'T run it --------
# Tier C of the supply-chain veto. Compile+run the target against the
# doppelganger std.os (records os.system/exec/run* instead of executing), then
# emit the recorded intent as JSON. The build's effects never fire.
if [[ -n "${AEB_TRACE_INTENT:-}" ]]; then
    _trace_targets=()
    for _a in "$@"; do
        case "$_a" in *.ae) _trace_targets+=("$_a") ;; esac
    done
    if [[ ${#_trace_targets[@]} -eq 0 ]]; then
        echo "aeb: --trace-intent needs a target (e.g. aeb --trace-intent app/.build.ae)" >&2
        exit 2
    fi
    AEB_TRACE_BIN="$AEB_HOME/tools/aeb-trace"
    if [[ ! -x "$AEB_TRACE_BIN" ]]; then
        "$AETHER" build "$AEB_HOME/tools/aeb-trace.ae" --lib "$AEB_HOME/lib" -o "$AEB_TRACE_BIN" 2>/dev/null
    fi
    # one target per trace (each build leaf is its own intent trace)
    _trace_out="$("$AEB_TRACE_BIN" "$AEB_HOME" "${_trace_targets[0]}")"
    _trace_rc=$?
    if [[ $_trace_rc -ne 0 ]]; then
        echo "aeb: --trace-intent failed (rc $_trace_rc): $_trace_out" >&2
        exit "$_trace_rc"
    fi
    if [[ -n "${AEB_INTENT_JSON:-}" && "${AEB_INTENT_JSON}" != "-" ]]; then
        printf '%s\n' "$_trace_out" > "${AEB_INTENT_JSON}"
        echo "aeb: intent trace written to ${AEB_INTENT_JSON}" >&2
    else
        printf '%s\n' "$_trace_out"
    fi
    exit 0
fi

# --- Remote offload: --use-remote-agents routes to aeb-remote instead of
# building locally. It leases from the --agents pool, names git HEAD as the
# base, sends `git diff HEAD` as the patch, dispatches, and folds the
# remote verdict (exiting with the remote build's pass/fail).
if [[ -n "${AEB_USE_REMOTE_AGENTS:-}" ]]; then
    AEB_REMOTE_BIN="$AEB_HOME/tools/aeb-remote"
    if [[ ! -x "$AEB_REMOTE_BIN" ]]; then
        "$AETHER" build "$AEB_HOME/tools/aeb-remote.ae" --lib "$AEB_HOME/lib" -o "$AEB_REMOTE_BIN" 2>/dev/null
    fi
    exec "$AEB_REMOTE_BIN" "$@"
fi

# --- --vet gate: vet the build BEFORE building ----------------------
# When AEB_VET=1, run the supply-chain veto before any build runs and
# refuse (exit 3) on any veto. Two layers run here, both fail-closed:
#   1b external-tool hook (--vet-tool <cmd>) — operator scanners; a
#      non-zero exit vetoes. Runs first.
#   2b AST gate (tools/aeb-vet) — resolves the operator policy
#      (AEB_VETO_POLICY / $AEB_HOME/veto/default.ae / built-in default),
#      refuses an in-tree policy, enforces the zero-rules lint, runs
#      lib/veto's decide() per target.
# See docs/build-veto-and-sandbox.md.
# Two scopes, matching the two build modes:
#   target mode — vets the explicitly-named *.ae targets on the CLI.
#   scan mode (--scan <glob>) — walks the tree (scan-ae-files, the same
#     discovery aeb-main uses), keeps nodes whose basename matches the
#     glob, and vets that whole set. This is the whole-tree veto, scoped
#     by the required --scan glob (no un-scoped tree vet by accident).
# The first veto refuses the entire build (exit 3) — fail-closed.
if [[ -n "${AEB_VET:-}" ]]; then
    ROOT="$(pwd)"

    # --- Layer 1b: external-tool hook (--vet-tool <cmd>) ---------------
    # Run each operator-named scanner with the build root as cwd, BEFORE
    # the AST gate and before any build. A non-zero exit vetoes (exit 3).
    # aeb invokes a SAST engine rather than becoming one. Fail-closed: a
    # tool that errors (incl. command-not-found, exit 127) vetoes too — a
    # vet you asked for that can't run must not silently pass.
    if [[ -n "${AEB_VET_TOOLS:-}" ]]; then
        while IFS= read -r _vt; do
            [[ -n "$_vt" ]] || continue
            echo "aeb --vet: running tool: ${_vt}" >&2
            # Run in a subshell cd'd to the root so the scanner sees the
            # tree; the command is operator-trusted (it came from the CLI,
            # not the build graph), so word-splitting it via the shell is
            # intended (lets `--vet-tool 'semgrep --error .'` work). The
            # `if !` form keeps errexit (set -e) from aborting before we
            # can convert a non-zero exit (incl. 127 not-found) into a veto.
            _vt_rc=0
            ( cd "$ROOT" && eval "$_vt" ) || _vt_rc=$?
            if [[ $_vt_rc -ne 0 ]]; then
                echo "aeb --vet: REFUSED — vet-tool exited ${_vt_rc}: ${_vt}" >&2
                echo "aeb: build refused by --vet (see above)" >&2
                exit 3
            fi
        done <<< "${AEB_VET_TOOLS}"
    fi

    AEB_VET_BIN="$AEB_HOME/tools/aeb-vet"
    if [[ ! -x "$AEB_VET_BIN" ]]; then
        "$AETHER" build "$AEB_HOME/tools/aeb-vet.ae" --lib "$AEB_HOME/lib" -o "$AEB_VET_BIN" 2>/dev/null
    fi
    _vet_targets=()
    if [[ -n "${AEB_SCAN:-}" ]]; then
        # Scan mode: discover the tree, filter by the glob's basename
        # (bash fnmatch == string.glob_match semantics: * ? [abc]).
        AEB_SCAN_BIN="$AEB_HOME/tools/scan-ae-files"
        if [[ ! -x "$AEB_SCAN_BIN" ]]; then
            "$AETHER" build "$AEB_HOME/tools/scan-ae-files.ae" -o "$AEB_SCAN_BIN" 2>/dev/null
        fi
        while IFS= read -r _p; do
            [[ -n "$_p" ]] || continue
            _b="${_p##*/}"
            # shellcheck disable=SC2053
            [[ "$_b" == ${AEB_SCAN} ]] && _vet_targets+=("$_p")
        done < <("$AEB_SCAN_BIN" 2>/dev/null)
    else
        for _a in "$@"; do
            case "$_a" in *.ae) _vet_targets+=("$_a") ;; esac
        done
    fi
    if [[ ${#_vet_targets[@]} -gt 0 ]]; then
        if ! "$AEB_VET_BIN" "$AETHER" "$AEB_HOME" "$ROOT" "${_vet_targets[@]}"; then
            echo "aeb: build refused by --vet (see above)" >&2
            exit 3
        fi
    elif [[ -n "${AEB_SCAN:-}" ]]; then
        echo "aeb: --vet --scan '${AEB_SCAN}' matched no .ae nodes — nothing vetted" >&2
    else
        echo "aeb: --vet set but no explicit *.ae target named — name a target or use --scan <glob>" >&2
    fi
fi

# --- Normal build: lazy-build the main tool ---
AEB_MAIN_BIN="$AEB_HOME/tools/aeb-main"
if [[ ! -x "$AEB_MAIN_BIN" ]]; then
    # COLD BOOTSTRAP: no prebuilt aeb-main (a source-only ship, or a tree
    # where `make install` never ran). Two details are load-bearing and
    # were both missing until 2026-07-26 — the bug was invisible because
    # `make install` normally pre-builds this binary, so the path only runs
    # on a genuinely cold tree:
    #
    #   --lib "$AEB_HOME/tools" --lib "$AEB_HOME/lib"
    #     aeb-main imports `build` (build._exe_suffix) and `aeblabel`. cwd
    #     is the USER'S PROJECT here, not $AEB_HOME, and aetherc resolves
    #     imports against cwd + --lib — so without these it fails with
    #     `E0301: Undefined function 'build._exe_suffix'`.
    #
    #   no 2>/dev/null
    #     that swallowed the E0301 and left an unbuilt binary, so the next
    #     line exec'd something that did not exist and aeb died with no
    #     output at all. A bootstrap that cannot bootstrap must SAY SO.
    if ! "$AETHER" build "$AEB_HOME/tools/aeb-main.ae" -o "$AEB_MAIN_BIN" \
             --lib "$AEB_HOME/tools" --lib "$AEB_HOME/lib"; then
        echo "aeb: could not build tools/aeb-main from source (see the aetherc error above)." >&2
        echo "aeb:   this is the cold-bootstrap path; \`make install\` normally pre-builds it." >&2
        exit 1
    fi
fi

if [[ -n "${AEB_TELEMETRY_JSON:-}" && -z "${AEB_VERSION:-}" ]]; then
    stamp="$AEB_HOME/AEB_STAMP"
    if [[ -f "$stamp" ]]; then
        src=$(awk '$1=="src"{print $2}' "$stamp")
        commit=$(awk '$1=="commit"{print $2}' "$stamp")
        installed=$(awk '$1=="installed"{sub(/^installed /,"");print}' "$stamp")
        export AEB_VERSION="aeb 0.0.0-dev+${src}   (git ${commit}, installed ${installed})"
    else
        export AEB_VERSION="aeb 0.0.0-dev   (no AEB_STAMP — un-installed tree at $AEB_HOME)"
    fi
fi

# --- --sandbox gate: run the build under runtime containment ---------
# When AEB_SANDBOX=1, the build is launched through tools/aeb-sandbox,
# which spawn_sandboxed's the whole aeb-main run under the operator grant
# profile. The launch command becomes a prefix array prepended to the
# normal aeb-main argv; everything downstream (process group, reap,
# timeout) is unchanged. Composes with --vet (vetted above, then run
# contained here).
AEB_LAUNCH=("$AEB_MAIN_BIN")
if [[ -n "${AEB_SANDBOX:-}" ]]; then
    AEB_SANDBOX_BIN="$AEB_HOME/tools/aeb-sandbox"
    if [[ ! -x "$AEB_SANDBOX_BIN" ]]; then
        "$AETHER" build "$AEB_HOME/tools/aeb-sandbox.ae" --lib "$AEB_HOME/lib" --lib "$AEB_HOME/tools" -o "$AEB_SANDBOX_BIN" 2>/dev/null
    fi
    # Resolve $AETHER to an ABSOLUTE path for the sandboxed run: inside the
    # sandbox the env is restricted (only granted vars survive), so a bare
    # `ae` may not resolve via PATH — and a failed `ae`/`aetherc` exec kills
    # the whole contained build. The absolute path is exec-checked against
    # the exec grants directly, no PATH lookup needed.
    AETHER_ABS="$(command -v "$AETHER" 2>/dev/null || echo "$AETHER")"
    # aeb-sandbox <ae> <home> <root> <main-bin> [then the aeb-main argv]
    AEB_LAUNCH=("$AEB_SANDBOX_BIN" "$AETHER_ABS" "$AEB_HOME" "$ROOT" "$AEB_MAIN_BIN")
fi

# --- Run the build in its own process group, then reap survivors -----
# Bazel-style: the whole build (aeb-main -> aeb-link -> orchestrator ->
# any process a step spawned) runs as one backgrounded job, which `set -m`
# places in its own process group (pid == pgid). When the build finishes
# we group-kill anything still alive — a step that leaked a backgrounded
# server, a stray helper — so nothing lingers into aeb's own exit (a
# lingering native server has been seen to poison a sandboxed harness's
# exit; see server-daemon-snafu.md). The reap is a no-op when a build
# leaves nothing running, so it's always on.
#
# `--timeout N` / AEB_TIMEOUT=N (seconds, unset/0 = none) caps total
# wall-clock: a watchdog TERMs then KILLs the build group on overrun.
#
# We can no longer `exec` (we must outlive the build to reap it), so
# capture its status and propagate it. set +e: a non-zero build result
# must not abort the trampoline before the reap runs.
set +e
set -m
# Under --sandbox the aether binary aeb-main receives (and shells out to)
# must also be absolute — it ends up in the sandbox run-script's command,
# where bare-name PATH lookup is unreliable under the restricted env.
AEB_AETHER_ARG="$AETHER"
if [[ -n "${AEB_SANDBOX:-}" ]]; then
    AEB_AETHER_ARG="$(command -v "$AETHER" 2>/dev/null || echo "$AETHER")"
fi
"${AEB_LAUNCH[@]}" "$AEB_AETHER_ARG" "$AEB_HOME" "$ROOT" "$@" &
__aeb_pid=$!
# Forward interactive signals to the whole build group.
trap 'kill -INT  -"$__aeb_pid" 2>/dev/null' INT
trap 'kill -TERM -"$__aeb_pid" 2>/dev/null' TERM

__aeb_wd=""
__aeb_to_marker=""
if [[ -n "${AEB_TIMEOUT:-}" ]] && [[ "$AEB_TIMEOUT" -gt 0 ]]; then
    __aeb_to_marker="$(mktemp 2>/dev/null || echo "/tmp/aeb_timeout_$$")"
    rm -f "$__aeb_to_marker"
    # On overrun: mark that we timed out, then TERM the build group, give
    # it 5s, then KILL. (The marker lets us report the conventional
    # timeout exit code 124 rather than a raw signal status.)
    ( sleep "$AEB_TIMEOUT"
      : > "$__aeb_to_marker"
      echo "aeb: build exceeded timeout ${AEB_TIMEOUT}s; terminating" >&2
      kill -TERM -"$__aeb_pid" 2>/dev/null
      sleep 5
      kill -KILL -"$__aeb_pid" 2>/dev/null ) &
    __aeb_wd=$!
fi

wait "$__aeb_pid"
__aeb_rc=$?

# Cancel the watchdog if the build finished on its own.
if [[ -n "$__aeb_wd" ]]; then
    kill -- -"$__aeb_wd" 2>/dev/null
    wait "$__aeb_wd" 2>/dev/null
fi

# Reap any process the build leaked into its group: TERM, brief grace,
# then an uncatchable KILL. No-op when the group is already empty.
kill -TERM -"$__aeb_pid" 2>/dev/null
__g=0
while [[ $__g -lt 10 ]]; do
    kill -0 -"$__aeb_pid" 2>/dev/null || break
    sleep 0.1
    __g=$((__g + 1))
done
kill -KILL -"$__aeb_pid" 2>/dev/null

# A timeout reports 124 (coreutils `timeout` convention), regardless of
# the exact signal the build died from.
if [[ -n "$__aeb_to_marker" && -f "$__aeb_to_marker" ]]; then
    rm -f "$__aeb_to_marker"
    exit 124
fi
rm -f "$__aeb_to_marker" 2>/dev/null
exit "$__aeb_rc"
