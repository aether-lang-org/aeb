# The opt-in pair (skipped by `make install`, built by the remote-agent kit).
# Missing from this list until now for exactly that reason: the default build
# never produces them, so they never turned up in anyone's `git status`.
tools/aeb-keygen
tools/aeb-lease

# aeb modules
.aeb/

# Build output from the docs examples (regenerated by running them)
docs/examples/**/target/
tools/resolver/.deps.classpath

# Local-only homelab deploy scaffolding (has a specific NUC's IP/dir baked in)
itests/agent-container/deploy-to-nuc.sh
itests/agent-container/deploy-containerfile-to-nuc.sh

# Build artifacts and local session state (were never ignored — fixed)
/target/
/.claude/
tools/aeb-sandbox
tools/libaether_sandbox.so
tools/aeb-sbom
tools/aeb-trace
tools/bld-*.jar

# Release-payload version marker (written by release.yml into the bootstrap
# stage, read by make install into AEB_STAMP). Never present in the source tree.
/VERSION
